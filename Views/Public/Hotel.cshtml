            <li class="breadcrumb-item"><a href="#">@Model.Property.City</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Property.Name</li>
            </ol>
        </nav>

        <!-- Navigation tabs -->
        <ul class="nav nav-tabs hotel-nav-tabs">
            <li class="nav-item"><a class="nav-link active" href="#">@Localizer["Overview"]</a></li>
            <li class="nav-item"><a class="nav-link" href="#">@Localizer["InformationAndPrices"]</a></li>
            <li class="nav-item"><a class="nav-link" href="#">@Localizer["Amenities"]</a></li>
            <li class="nav-item"><a class="nav-link" href="#">@Localizer["GeneralRules"]</a></li>
            <li class="nav-item"><a class="nav-link" href="#">@Localizer["GuestReviews"] (327)</a></li>
            <li class="nav-item ms-auto"><a class="nav-link" href="#"><i class="bi bi-heart"></i></a></li>
            <li class="nav-item"><a class="nav-link" href="#"><i class="bi bi-share"></i></a></li>
        </ul>

        <!-- Tiêu đề khách sạn và các nút hành động -->
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <div class="star-rating mb-2">
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <span class="badge bg-warning text-dark ms-2"><i class="bi bi-flag"></i> Travel Proud</span>
                </div>
            <h1 class="mb-1">@Model.Property.Name</h1>
                <div class="hotel-address">
                <i class="bi bi-geo-alt"></i> @Model.Property.AddressLine, @Model.Property.PostalCode
                @Model.Property.City, @Model.Property.CountryCode
                    - <a href="#">@Localizer["ExcellentLocation"] - @Localizer["ShowOnMap"]</a>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="text-end me-3">
                    <div class="mb-1">
                        <span class="badge bg-info text-white">@Localizer["WeAlwaysMatchPrices"]</span>
                    </div>
                    <button class="btn btn-primary fw-bold px-4">@Localizer["BookNow"]</button>
                </div>
            </div>
        </div>

        <div class="row equal-row">
        <div class="col-12">
            <!-- Photos: New Layout -->
            <div class="photo-gallery mb-4">
                <!-- Ảnh chính bên trái -->
                <div class="gallery-item gallery-main" onclick="openFullGallery()">
                        <img src="@(Model.PhotoUrls.Count > 0 ? Model.PhotoUrls[0] : "/images/placeholder.jpg")"
                        alt="Main hotel view" class="hotel-photo-thumb">
                    </div>

                <!-- 6 ảnh nhỏ bên phải -->
                <div class="gallery-grid">
                    @{
                        var photoCount = Model.PhotoUrls?.Count ?? 0;
                    }
                    @if (photoCount > 6)
                    {
                        @* Hiển thị 5 ảnh đầu + 1 ảnh cuối với overlay *@
                        @for (int i = 1; i <= 5 && i < photoCount; i++)
                        {
                            <div class="gallery-item" onclick="openFullGallery()">
                                <img src="@Model.PhotoUrls[i]" alt="Hotel photo @i" class="hotel-photo-thumb">
                                </div>
                            }
                        @* Ảnh cuối với overlay "Xem tất cả" *@
                        <div class="gallery-item view-all" onclick="openFullGallery()">
                            <img src="@Model.PhotoUrls[photoCount - 1]" alt="View all photos"
                                class="hotel-photo-thumb">
                            <div class="photo-overlay-permanent">
                                <div class="overlay-content">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                        <polyline points="21 15 16 10 5 21"></polyline>
                                    </svg>
                                    <div>@Localizer["ViewAllImages"]</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Hiển thị tất cả ảnh (≤ 6) *@
                        @for (int i = 1; i < photoCount; i++)
                        {
                            <div class="gallery-item" onclick="openFullGallery()">
                                <img src="@Model.PhotoUrls[i]" alt="Hotel photo @i" class="hotel-photo-thumb">
                                </div>
                            }
                    }
                    @* Tạo placeholder cho các ô trống nếu cần *@
                    @if (photoCount <= 6)
                    {
                        @for (int i = photoCount; i <= 6; i++)
                        {
                            <div class="gallery-item">
                                <div class="d-flex align-items-center justify-content-center bg-light border rounded h-100">
                                    <i class="bi bi-image text-muted fs-4"></i>
                        </div>
                            </div>
                        }
                    }
                    </div>
                </div>

                <!-- Amenities -->
                <div class="amenities-grid mb-4">
                    <div class="amenity-item">
                        <i class="bi bi-water"></i>
                        <span>@Localizer["MountainView"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-tree"></i>
                        <span>@Localizer["Garden"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-water"></i>
                        <span>@Localizer["SwimmingPool"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-wifi"></i>
                        <span>@Localizer["FreeWiFi"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-door-open"></i>
                        <span>@Localizer["Terrace"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-people"></i>
                        <span>@Localizer["Balcony"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-p-circle"></i>
                        <span>@Localizer["FreeParking"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-droplet"></i>
                        <span>@Localizer["Bathtub"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-snow"></i>
                        <span>@Localizer["AirConditioning"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-clock"></i>
                        <span>@Localizer["Reception24Hours"]</span>
                    </div>
                </div>

                <!-- Hotel Description -->
                <div class="content-section">
                    <div class="section-title">@Localizer["EnjoyWorldClassService"]</div>
                    <p>@Localizer["LocatedInUongBi"]</p>

                    <p>@Localizer["HotelRoomsDescription"]</p>

                    <p>@Localizer["BreakfastService"]</p>

                    <p>@Localizer["DistanceToHaiPhong"]</p>

                    <p>@Localizer["CouplesLoveThisPlace"]</p>

                    <p style="font-size: 0.8rem; color: var(--booking-text-light);">@Localizer["DistanceNote"]</p>

                    <div class="mt-4">
                        <div class="section-title">@Localizer["MostPopularAmenities"]</div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-water text-info"></i>
                                    <span>@Localizer["TwoSwimmingPools"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-tree text-success"></i>
                                    <span>@Localizer["AirportShuttle"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-ban text-danger"></i>
                                    <span>@Localizer["NonSmokingRooms"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-p-circle text-primary"></i>
                                    <span>@Localizer["FreeParking"]</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-heart-pulse text-danger"></i>
                                    <span>@Localizer["SpaWellnessCenter"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-wifi text-primary"></i>
                                    <span>@Localizer["FreeWiFi"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-cup-straw text-warning"></i>
                                    <span>@Localizer["Restaurant"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-door-open text-success"></i>
                                    <span>@Localizer["RoomService"]</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-cup text-warning"></i>
                                    <span>@Localizer["Bar"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-leaf text-success"></i>
                                    <span>@Localizer["ExcellentBreakfast"]</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                

                <!-- Room Availability Table -->
                <table class="table availability-table">
                    <thead>
                        <tr>
                            <th>Loại chỗ nghỉ</th>
                            <th>Số lượng khách</th>
                            <th>Giá cho 3 đêm</th>
                            <th>Các lựa chọn</th>
                            <th>@Localizer["SelectRoom"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        </tbody>
                </table>

                <div class="rooms-list mt-3">
                        @if (Model.Rooms != null && Model.Rooms.Count > 0)
                        {
                            foreach (var r in Model.Rooms)
                        {
                            var guests = (r.CapacityAdults + r.CapacityChildren);
                            decimal? amount = null;
                            decimal a = default;
                            if (Model.RoomPrices != null && Model.RoomPrices.TryGetValue(r.Id, out a)) amount = a;
                        var firstPhoto = r.Photos?.FirstOrDefault()?.Url ?? "/images/placeholder.jpg";
                        var bedSummaryParts = new List<string>();
                        foreach (var b in (r.Beds ?? new List<HotelBooking.Models.RoomBed>()))
                        {
                            if (b == null) continue;
                            var typesCount = b.Types?.Count ?? 0;
                            var countsCount = b.Counts?.Count ?? 0;
                            var lim = Math.Min(typesCount, countsCount);
                            for (int i = 0; i < lim; i++)
                            {
                                var t = b.Types[i];
                                var c = b.Counts[i];
                                if (!string.IsNullOrWhiteSpace(t)) bedSummaryParts.Add($"{c} {t}");
                            }
                        }
                        var bedSummary = bedSummaryParts.Count > 0 ? string.Join(" hoặc ", bedSummaryParts) : Localizer["BedInformation"];
                        var cancellation = Model.PricePackage?.CancellationPolicy switch
                        {
                            "refund_1" => Localizer["RefundableUpTo1Day"],
                            "refund_3" => Localizer["RefundableUpTo3Days"],
                            "refund_7" => Localizer["RefundableUpTo7Days"],
                            "non_refundable" => Localizer["NonRefundable"],
                            _ => Model.PricePackage?.CancellationPolicyDisplayName ?? ""
                        };
                        var breakfastIncluded = Model.PricePackage?.BreakfastIncluded == true;

          

                        <div class="room-card">
                            <div class="room-photo-section" role="button" tabindex="0" aria-label="@Localizer["ViewRoomDetails"]" data-room-id="@r.Id">
                                <img src="@firstPhoto" alt="@r.Name" />
                                <div class="info-badges">
                                    <span class="badge-item"><i class="bi bi-aspect-ratio me-1"></i> @r.Size m²</span>
                                    <span class="badge-item"><i class="bi bi-droplet me-1"></i> @Localizer["StandingShower"]</span>
                                    <span class="badge-item"><i class="bi bi-snow me-1"></i> @Localizer["AirConditioning"]</span>
                                </div>
                                <a href="javascript:void(0)" class="room-detail-link" data-room-id="@r.Id">
                                    <i class="bi bi-grid-3x3-gap"></i> @Localizer["ViewRoomDetails"]
                                </a>
                            </div>

                            <div class="room-info-section">
                                <h5 class="room-name" role="button" data-room-id="@r.Id">@r.Name</h5>
                                <div class="room-type-label">@(breakfastIncluded ? Localizer["IncludesBreakfast"] : Localizer["DoesNotIncludeBreakfast"])</div>

                                <div class="room-details">
                                    <div class="detail-item">
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                        <span>@bedSummary</span>
                                    </div>
                                    <div class="detail-item">
                                        <i class="bi bi-info-circle"></i>
                                        <span>@Localizer["ChildPolicyDetails"]</span>
                                    </div>
                                    <div class="detail-item text-primary fw-bold">
                                        <i class="bi bi-credit-card"></i>
                                        <span>@Localizer["PayAtHotel"]</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(cancellation))
                                    {
                                        <div class="detail-item text-success">
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>@cancellation</span>
                                            <i class="bi bi-info-circle ms-1"></i>
                                        </div>
                                    }
                                    <div class="detail-item">
                                        <i class="bi bi-arrow-repeat"></i>
                                        <span>@Localizer["CancellationPolicyApplies"]</span>
                                        <i class="bi bi-info-circle ms-1"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="room-booking-section">
                                <div class="guest-info">
                                    <i class="bi bi-people-fill"></i>
                                    <span>&nbsp;@guests</span>
                                </div>
                                <div class="price-info">
                                    @if(amount.HasValue)
                                    {
                                        <div class="old-price">@string.Format("{0:N0} VND", amount.Value * 1.25m)</div>
                                        <div class="current-price">@string.Format("{0:N0} VND", amount.Value)</div>
                                                                        }
                                        else
                                        {
                                        <div class="current-price">Giá đang cập nhật</div>
                                        }
                                    <div class="price-note">@Localizer["IncludesTaxAndFees"]</div>
                                    </div>
                                    @{
                                        var checkInDate = ((DateTime?)ViewBag.Checkin)?.ToString("yyyy-MM-dd");
                                        var checkOutDate = ((DateTime?)ViewBag.Checkout)?.ToString("yyyy-MM-dd");
                                    }
                                    <a class="btn-choose"
                                       asp-controller="Booking"
                                       asp-action="Book"
                                       asp-route-propertyId="@Model.Property.Id"
                                       asp-route-roomId="@r.Id"
                                       asp-route-checkIn="@checkInDate"
                                       asp-route-checkOut="@checkOutDate">
                                        @Localizer["Select"]
                                    </a>

                            </div>
                        </div>
                        }
                        }
                        else
                        {
                            <div class="alert alert-info">Chưa có phòng nào được cấu hình cho khách sạn này.</div>
                        }
                </div>

<style>
    /* Danh sách các card phòng */
    .rooms-list { display: flex; flex-direction: column; gap: 16px; }
    .room-card { display: grid; grid-template-columns: 380px 1fr 300px; background: #fff; border-radius: 12px; border: 1px solid #e6e6e6; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }

    /* Cột 1: Ảnh & Tiện ích */
    .room-photo-section { padding: 16px; position: relative; border-right: 1px solid #e6e6e6; }
    .room-photo-section img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; margin-bottom: 12px; }
    .info-badges { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.85rem; color: #333; }
    .badge-item { background-color: #f3f4f6; padding: 5px 10px; border-radius: 16px; }
    .room-detail-link { margin-top: 16px; display: inline-block; color: #006ce4; font-weight: 600; text-decoration: none; font-size: 0.9rem; }
    .room-detail-link:hover { text-decoration: underline; }

    /* Cột 2: Thông tin phòng */
    .room-info-section { padding: 20px; border-right: 1px solid #e6e6e6; }
    .room-name { font-weight: 700; font-size: 1.15rem; margin-bottom: 4px; }
    .room-type-label { font-size: 0.9rem; color: #6b7280; margin-bottom: 16px; }
    .room-details { display: flex; flex-direction: column; gap: 12px; }
    .detail-item { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
    .detail-item i { font-size: 1.1rem; }

    /* Cột 3: Giá & Đặt phòng */
    .room-booking-section { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; gap: 8px; }
    .guest-info { font-size: 1rem; color: #333; }
    .price-info { text-align: center; margin: 8px 0; }
    .special-label { color: #d32f2f; font-size: 0.8rem; font-weight: 600; }
    .old-price { color: #6b7280; font-size: 0.95rem; text-decoration: line-through; }
