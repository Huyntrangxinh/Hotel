    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const ROOM_DATA = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (Model.Rooms ?? new List<HotelBooking.Models.Room>()).Where(r => r != null).Select(r => new {
                id = r.Id,
                name = r.Name ?? string.Empty,
                size = r.Size ?? 0,
                unit = r.SizeUnit ?? "m²",
                adults = r.CapacityAdults,
                children = r.CapacityChildren,
                price = (Model.RoomPrices != null && Model.RoomPrices.TryGetValue(r.Id, out var price)) ? price : (decimal?)null,
                amenities = (r.Amenities ?? new List<HotelBooking.Models.RoomAmenity>())
                    .Where(a => a != null && !string.IsNullOrEmpty(a.Name))
                    .Select(a => a.Name!),
                photos = (r.Photos ?? new List<HotelBooking.Models.RoomPhoto>())
                    .Where(p => p != null && !string.IsNullOrEmpty(p.Url))
                    .Select(p => p.Url!)
            })
        ));
        
        // Property amenities from PropertyData
        @{
            var propertyAmenitiesJson = "[]";
            if (ViewBag.PropertyAmenities != null)
            {
                var amenitiesList = ((List<(string Name, string Icon, string LocalizerKey)>)ViewBag.PropertyAmenities)
                    .Select(a => new { name = a.Name, icon = a.Icon, key = a.LocalizerKey })
                    .ToList();
                propertyAmenitiesJson = System.Text.Json.JsonSerializer.Serialize(amenitiesList);
            }
        }
        const PROPERTY_AMENITIES = @Html.Raw(propertyAmenitiesJson);

        (function () {
            const modalEl = document.getElementById('roomDetailModal');
            const modal = new bootstrap.Modal(modalEl);
            
            // Amenity mapping for localization (Room amenities + Property amenities)
            const amenityMap = {
                // Room amenities
                'Ban công sân thượng': '@Localizer["TerraceBalcony"]',
                'Hồ bơi riêng': '@Localizer["PrivatePool"]',
                'Điều hòa không khí': '@Localizer["AirConditioning"]',
                'Bàn làm việc': '@Localizer["WorkDesk"]',
                'Lò vi sóng': '@Localizer["Microwave"]',
                'Đồ ủi': '@Localizer["IroningFacilities"]',
                'Tivi': '@Localizer["TV"]',
                'Mini bar': '@Localizer["MiniBar"]',
                'Máy sấy tóc': '@Localizer["HairDryer"]',
                'Wifi': '@Localizer["Wifi"]',
                'Máy giặt': '@Localizer["WashingMachine"]',
                'Nhà tắm chung': '@Localizer["SharedBathroom"]',
                'Tủ lạnh': '@Localizer["Refrigerator"]',
                // Property amenities
                'SmokingArea': '@Localizer["SmokingArea"]',
                'AccessibleBathroom': '@Localizer["AccessibleBathroom"]',
                'Elevator': '@Localizer["Elevator"]',
                'FreeWiFi': '@Localizer["FreeWiFi"]',
                'AccessibleParking': '@Localizer["AccessibleParking"]',
                'FreeParking': '@Localizer["FreeParking"]',
                'Cafe': '@Localizer["Cafe"]',
                'Restaurant': '@Localizer["Restaurant"]',
                'Bar': '@Localizer["Bar"]',
                'FrontDesk': '@Localizer["FrontDesk"]',
                'ExpressCheckIn': '@Localizer["ExpressCheckIn"]',
                'Concierge': '@Localizer["Concierge"]',
                'ExpressCheckOut': '@Localizer["ExpressCheckOut"]',
                'LaundryService': '@Localizer["LaundryService"]',
                '24HourSecurity': '@Localizer["24HourSecurity"]',
                'LuggageStorage': '@Localizer["LuggageStorage"]',
                'AirportTransfer': '@Localizer["AirportTransfer"]',
                'Máy pha cà phê/trà': '@Localizer["CoffeeTeaMaker"]',
                'Đồ dùng vệ sinh': '@Localizer["Toiletries"]',
                'Áo choàng tắm': '@Localizer["Bathrobe"]',
                'Bồn tắm': '@Localizer["Bathtub"]',
                'Vòi sen': '@Localizer["Shower"]',
                'Nhà tắm riêng': '@Localizer["PrivateBathroom"]',
                'Nước nóng': '@Localizer["HotWater"]'
            };
            
            function openRoom(id) {
                const r = ROOM_DATA.find(x => x.id === id);
                if (!r) { modal.show(); return; }
                document.getElementById('rdmTitle').textContent = r.name;
                document.getElementById('rdmSpecs').innerHTML = `
                    <div>• @Localizer["Size"]: ${r.size || ''} ${r.unit || ''}</div>
                    <div>• @Localizer["Capacity"]: ${r.adults + r.children} @Localizer["Guests"] (👤 ${r.adults} · 🧒 ${r.children})</div>
                `;
                const slides = document.getElementById('rdmSlides');
                slides.innerHTML = '';
                const thumbs = document.getElementById('rdmThumbs');
                thumbs.innerHTML = '';
                (r.photos && r.photos.length ? r.photos : ['/images/placeholder.jpg']).forEach((u, idx) => {
                    const active = idx === 0 ? 'active' : '';
                    slides.insertAdjacentHTML('beforeend', `<div class="carousel-item ${active}"><img class="d-block w-100" style="height:420px;object-fit:cover" src="${u}"></div>`);
                    thumbs.insertAdjacentHTML('beforeend', `<img src="${u}" style="width:72px;height:54px;object-fit:cover;border-radius:4px;cursor:pointer" data-idx="${idx}">`);
                });
                thumbs.querySelectorAll('img').forEach(img => {
                    img.addEventListener('click', e => {
                        const idx = parseInt(e.currentTarget.getAttribute('data-idx'));
                        bootstrap.Carousel.getOrCreateInstance(document.getElementById('rdmCarousel')).to(idx);
                    });
                });
                const am = document.getElementById('rdmAmenities');
                // Hiển thị Property amenities (từ PropertyData) thay vì Room amenities
                if (PROPERTY_AMENITIES && PROPERTY_AMENITIES.length > 0) {
                    am.innerHTML = PROPERTY_AMENITIES.map(a => {
                        const localizedName = amenityMap[a.key] || a.name;
                        return `<div>✓ <i class="bi ${a.icon} me-1"></i>${localizedName}</div>`;
                    }).join('');
                } else if (r.amenities && r.amenities.length) {
                    // Fallback: hiển thị Room amenities nếu không có Property amenities
                    am.innerHTML = r.amenities.map(a => `<div>✓ ${amenityMap[a] || a}</div>`).join('');
                } else {
                    am.innerHTML = '<div class="text-muted">@Localizer["NoAmenitiesUpdated"]</div>';
                }
                
                // Hiển thị giá phòng
                const priceEl = document.getElementById('rdmPrice');
                if (priceEl) {
                    if (r.price && r.price > 0) {
                        // Format giá theo định dạng VND
                        const formattedPrice = new Intl.NumberFormat('vi-VN').format(r.price);
                        priceEl.textContent = `${formattedPrice} VND`;
                        priceEl.classList.remove('text-muted');
                        priceEl.classList.add('text-danger');
                    } else {
                        priceEl.textContent = 'Giá đang cập nhật';
                        priceEl.classList.remove('text-danger');
                        priceEl.classList.add('text-muted');
                    }
                }
                
                // Gắn điều hướng Book trong modal kèm ngày từ ViewBag
                (function(){
                    const bookBtn = document.getElementById('rdmBookBtn');
                    if (bookBtn) {
                        const ci = '@(((DateTime?)ViewBag.Checkin)?.ToString("yyyy-MM-dd"))';
                        const co = '@(((DateTime?)ViewBag.Checkout)?.ToString("yyyy-MM-dd"))';
                        bookBtn.onclick = function(){
                            const qs = (ci || co) ? `&checkIn=${encodeURIComponent(ci)}&checkOut=${encodeURIComponent(co)}` : '';
                            const url = `/Booking/Book?propertyId=${encodeURIComponent(@Model.Property.Id)}&roomId=${encodeURIComponent(id)}${qs}`;
                            window.location.href = url;
                        };
                    }
                })();
                modal.show();
            }
            document.querySelectorAll('.room-detail-link').forEach(a => {
                a.addEventListener('click', function (ev) { ev.preventDefault(); openRoom(parseInt(this.getAttribute('data-room-id'))); });
            });
        })();
    </script>

    <script>
        (function () {
            const modal = new bootstrap.Modal(document.getElementById('photoModal'));

        // Xử lý click vào overlay "Xem tất cả hình ảnh"
        document.querySelectorAll('.photo-overlay-permanent').forEach(overlay => {
            overlay.addEventListener('click', () => modal.show());
            });
        })();
    </script>

<!-- Full Gallery Modal -->
<div class="full-gallery-overlay" id="fullGallery" style="display: none;">
    <div class="full-gallery-container">
        <div class="gallery-header">
            <h2 class="gallery-title">@Localizer["HotelImages"]</h2>
            <button class="close-gallery" onclick="closeFullGallery()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div style="position: relative;">
            @{ var mainIdx = (Model.PhotoUrls?.Count ?? 0) > 0 ? 0 : -1; }
            <img id="mainGalleryImage" class="main-gallery-image" src="@(mainIdx >= 0 ? Model.PhotoUrls[mainIdx] : "/images/placeholder.jpg")" alt="Hotel photo">
            <button class="gallery-navigation gallery-nav-prev" onclick="previousImage()">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="gallery-navigation gallery-nav-next" onclick="nextImage()">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>

        <div class="gallery-image-info">
            <div class="gallery-category" id="galleryImageCategory">@Localizer["ExteriorBuilding"]</div>
            <div class="gallery-counter" id="galleryImageCounter">2/@(Model.PhotoUrls.Count + Model.RoomPhotoUrls.Count)
            </div>
        </div>

        <div class="gallery-categories">
            <button class="gallery-category-tab active" data-category="all" onclick="filterGalleryByCategory('all')">
                @Localizer["AllImages"] (@(Model.PhotoUrls.Count + Model.RoomPhotoUrls.Count))
            </button>
            <button class="gallery-category-tab" data-category="exterior" onclick="filterGalleryByCategory('exterior')">
                @Localizer["Exterior"] (3)
            </button>
            <button class="gallery-category-tab" data-category="lobby" onclick="filterGalleryByCategory('lobby')">
                @Localizer["Lobby"] (8)
            </button>
            <button class="gallery-category-tab" data-category="restaurant"
                onclick="filterGalleryByCategory('restaurant')">
                @Localizer["Restaurant"] (19)
            </button>
            <button class="gallery-category-tab" data-category="bar" onclick="filterGalleryByCategory('bar')">
                @Localizer["BarCafeLounge"] (8)
            </button>
            <button class="gallery-category-tab" data-category="pool" onclick="filterGalleryByCategory('pool')">
                @Localizer["SwimmingPool"] (4)
            </button>
            <button class="gallery-category-tab" data-category="rooms" onclick="filterGalleryByCategory('rooms')">
                @Localizer["Rooms"] (@Model.RoomPhotoUrls.Count)
            </button>
            <button class="gallery-category-tab" data-category="amenities"
                onclick="filterGalleryByCategory('amenities')">
                @Localizer["Amenities"] (6)
            </button>
        </div>

        <div class="gallery-thumbnails" id="galleryThumbnails">
            @for (int i = 0; i < Model.PhotoUrls.Count; i++)
            {
                <div class="gallery-thumbnail @(i == 1 ? "active" : "")" data-index="@i" onclick="selectImage(@i)">
                    <img src="@Model.PhotoUrls[i]" alt="Hotel photo @(i + 1)">
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Date picker removed per request

    document.addEventListener('DOMContentLoaded', function () {
        // search UI removed
    });

    // search functions removed

    // Gallery functionality
    let currentGalleryImageIndex = 1; // Start with second image
    let currentGalleryCategory = 'all';
    const galleryPhotoUrls = @Html.Raw(Json.Serialize(Model.PhotoUrls));
    const roomPhotoUrls = @Html.Raw(Json.Serialize(Model.RoomPhotoUrls));

    function openFullGallery() {
        document.getElementById('fullGallery').style.display = 'block';
        document.body.style.overflow = 'hidden';
        filterGalleryByCategory(currentGalleryCategory); // Re-apply current category filter
        updateMainImage();
        updateThumbnails();
        updateImageCounter();
    }

    function closeFullGallery() {
        document.getElementById('fullGallery').style.display = 'none';
        document.body.style.overflow = 'auto';
    }

    function filterGalleryByCategory(category) {
        currentGalleryCategory = category;
        document.querySelectorAll('.gallery-category-tab').forEach(tab => {
            tab.classList.toggle('active', tab.dataset.category === category);
        });

        const photoSet = getCurrentPhotoSet();
        currentGalleryImageIndex = photoSet.length > 1 ? 1 : 0; // Start with second image if available, else first

        updateMainImage();
        updateThumbnails();
        updateImageCounter();
    }

    function getCurrentPhotoSet() {
        switch (currentGalleryCategory) {
            case 'all':
                return [...galleryPhotoUrls, ...roomPhotoUrls];
            case 'exterior':
                return galleryPhotoUrls.filter(url => url.includes('exterior')); // Assuming URL contains category info
            case 'lobby':
                return galleryPhotoUrls.filter(url => url.includes('lobby'));
            case 'restaurant':
                return galleryPhotoUrls.filter(url => url.includes('restaurant'));
            case 'bar':
                return galleryPhotoUrls.filter(url => url.includes('bar'));
            case 'pool':
                return galleryPhotoUrls.filter(url => url.includes('pool'));
            case 'rooms':
                return roomPhotoUrls;
            case 'amenity':
                return galleryPhotoUrls.filter(url => url.includes('amenity'));
            default:
                return [...galleryPhotoUrls, ...roomPhotoUrls];
        }
    }

    function updateMainImage() {
        const photoSet = getCurrentPhotoSet();
        const mainImage = document.getElementById('mainGalleryImage');
        if (photoSet.length > 0 && mainImage) {
            mainImage.src = photoSet[currentGalleryImageIndex];
        } else if (mainImage) {
            mainImage.src = ''; // Clear image if no photos
        }
        // update category label and counter
        const counter = document.getElementById('galleryImageCounter');
        if (counter) counter.textContent = `${currentGalleryImageIndex + 1}/${photoSet.length}`;
    }

    function updateThumbnails() {
        const photoSet = getCurrentPhotoSet();
        const thumbnailsContainer = document.getElementById('galleryThumbnails');
        if (thumbnailsContainer) {
            thumbnailsContainer.innerHTML = photoSet.map((url, index) => `
                <div class="gallery-thumbnail ${index === currentGalleryImageIndex ? 'active' : ''}" data-index="${index}" onclick="selectImage(${index})">
                    <img src="${url}" alt="Thumbnail ${index + 1}">
                </div>
            `).join('');
        }
    }

    function updateImageCounter() {
        const photoSet = getCurrentPhotoSet();
        const counter = document.getElementById('galleryImageCounter');
        if (counter) {
            counter.textContent = `${currentGalleryImageIndex + 1}/${photoSet.length}`;
        }
    }

    function selectImage(index) {
        currentGalleryImageIndex = index;
        updateMainImage();
        updateThumbnails();
        updateImageCounter();
    }

    function previousImage() {
        const photoSet = getCurrentPhotoSet();
        currentGalleryImageIndex = (currentGalleryImageIndex > 0) ? currentGalleryImageIndex - 1 : photoSet.length - 1;
        updateMainImage();
        updateThumbnails();
        updateImageCounter();
    }

    function nextImage() {
        const photoSet = getCurrentPhotoSet();
        currentGalleryImageIndex = (currentGalleryImageIndex < photoSet.length - 1) ? currentGalleryImageIndex + 1 : 0;
        updateMainImage();
        updateThumbnails();
        updateImageCounter();
    }

    // Keyboard navigation
    document.addEventListener('keydown', function (e) {
        const gallery = document.getElementById('fullGallery');
        if (gallery && gallery.style.display === 'block') {
            if (e.key === 'Escape') {
                closeFullGallery();
            } else if (e.key === 'ArrowLeft') {
                previousImage();
            } else if (e.key === 'ArrowRight') {
                nextImage();
            }
        }
    });

    // Close on overlay click
    document.getElementById('fullGallery').addEventListener('click', (e) => {
        if (e.target.id === 'fullGallery') {
            closeFullGallery();
        }
    });

    // Gallery thumbnail selection
    // old selectGalleryImage removed; selectImage is used

    // Show all reviews functionality
    document.addEventListener('DOMContentLoaded', function() {
        const showAllBtn = document.getElementById('showAllReviewsBtn');
        if (showAllBtn) {
            showAllBtn.addEventListener('click', function() {
                const hiddenReviews = document.querySelectorAll('.review-item.d-none');
                hiddenReviews.forEach(function(review) {
                    review.classList.remove('d-none');
                });
                showAllBtn.style.display = 'none';
            });
        }
    });
</script>
