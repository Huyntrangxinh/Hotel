                        foreach (var paragraph in paragraphs)
                        {
                            if (!string.IsNullOrWhiteSpace(paragraph))
                            {
                                <p>@paragraph</p>
                            }
                        }
                    }
                    else
                    {
                        <!-- Fallback to old localization if description not available -->
                    <div class="section-title">@Localizer["EnjoyWorldClassService"]</div>
                    <p>@Localizer["LocatedInUongBi"]</p>
                    <p>@Localizer["HotelRoomsDescription"]</p>
                    <p>@Localizer["BreakfastService"]</p>
                    <p>@Localizer["DistanceToHaiPhong"]</p>
                    <p>@Localizer["CouplesLoveThisPlace"]</p>
                    <p style="font-size: 0.8rem; color: var(--booking-text-light);">@Localizer["DistanceNote"]</p>
                    }

                    <div class="mt-4">
                        <div class="section-title">@Localizer["MostPopularAmenities"]</div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-water text-info"></i>
                                    <span>@Localizer["TwoSwimmingPools"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-tree text-success"></i>
                                    <span>@Localizer["AirportShuttle"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-ban text-danger"></i>
                                    <span>@Localizer["NonSmokingRooms"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-p-circle text-primary"></i>
                                    <span>@Localizer["FreeParking"]</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-heart-pulse text-danger"></i>
                                    <span>@Localizer["SpaWellnessCenter"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-wifi text-primary"></i>
                                    <span>@Localizer["FreeWiFi"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-cup-straw text-warning"></i>
                                    <span>@Localizer["Restaurant"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-door-open text-success"></i>
                                    <span>@Localizer["RoomService"]</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-cup text-warning"></i>
                                    <span>@Localizer["Bar"]</span>
                                </div>
                                <div class="amenity-item mb-2">
                                    <i class="bi bi-leaf text-success"></i>
                                    <span>@Localizer["ExcellentBreakfast"]</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                

                <!-- Room Availability Table -->
                <table class="table availability-table">
                    <thead>
                        <tr>
                            <th>Loại chỗ nghỉ</th>
                            <th>Số lượng khách</th>
                            <th>Giá cho 3 đêm</th>
                            <th>Các lựa chọn</th>
                            <th>@Localizer["SelectRoom"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        </tbody>
                </table>

                <div class="rooms-list mt-3">
                        @if (Model.Rooms != null && Model.Rooms.Count > 0)
                        {
                            foreach (var r in Model.Rooms)
                        {
                            var guests = (r.CapacityAdults + r.CapacityChildren);
                            decimal? amount = null;
                            decimal a = default;
                            if (Model.RoomPrices != null && Model.RoomPrices.TryGetValue(r.Id, out a)) amount = a;
                        var firstPhoto = r.Photos?.FirstOrDefault()?.Url ?? "/images/placeholder.jpg";
                        var bedSummaryParts = new List<string>();
                        foreach (var b in (r.Beds ?? new List<HotelBooking.Models.RoomBed>()))
                        {
                            if (b == null) continue;
                            var typesCount = b.Types?.Count ?? 0;
                            var countsCount = b.Counts?.Count ?? 0;
                            var lim = Math.Min(typesCount, countsCount);
                            for (int i = 0; i < lim; i++)
                            {
                                var t = b.Types[i];
                                var c = b.Counts[i];
                                if (!string.IsNullOrWhiteSpace(t)) bedSummaryParts.Add($"{c} {t}");
                            }
                        }
                        var bedSummary = bedSummaryParts.Count > 0 ? string.Join(" hoặc ", bedSummaryParts) : Localizer["BedInformation"];
                        var cancellation = Model.PricePackage?.CancellationPolicy switch
                        {
                            "refund_1" => Localizer["RefundableUpTo1Day"],
                            "refund_3" => Localizer["RefundableUpTo3Days"],
                            "refund_7" => Localizer["RefundableUpTo7Days"],
                            "non_refundable" => Localizer["NonRefundable"],
                            _ => Model.PricePackage?.CancellationPolicyDisplayName ?? ""
                        };
                        var breakfastIncluded = Model.PricePackage?.BreakfastIncluded == true;
                        var checkInDate = ((DateTime?)ViewBag.Checkin)?.ToString("yyyy-MM-dd");
                        var checkOutDate = ((DateTime?)ViewBag.Checkout)?.ToString("yyyy-MM-dd");

                        <div class="room-card">
                            <div class="room-photo-section">
                                <h5 class="room-name" role="button" data-room-id="@r.Id">@r.Name</h5>
                                <div class="room-photo-wrapper" role="button" tabindex="0" aria-label="@Localizer["ViewRoomDetails"]" data-room-id="@r.Id">
                                <img src="@firstPhoto" alt="@r.Name" />
                                <div class="info-badges">
                                    <span class="badge-item"><i class="bi bi-aspect-ratio me-1"></i> @r.Size m²</span>
                                    <span class="badge-item"><i class="bi bi-droplet me-1"></i> @Localizer["StandingShower"]</span>
                                    <span class="badge-item"><i class="bi bi-snow me-1"></i> @Localizer["AirConditioning"]</span>
                                    </div>
                                </div>
                                <a href="javascript:void(0)" class="room-detail-link" data-room-id="@r.Id">
                                    <i class="bi bi-grid-3x3-gap"></i> @Localizer["ViewRoomDetails"]
                                </a>
                            </div>

                            <div class="room-info-section">
                                <div class="room-booking-section">
                                @{
                                    // Load room prices from database (ViewBag.RoomPricesByRoom)
                                    var roomOptions = new List<dynamic>();
                                    var roomPricesForRoom = ViewBag.RoomPricesByRoom != null && 
                                        ((Dictionary<int, List<HotelBooking.Models.RoomPrice>>)ViewBag.RoomPricesByRoom).ContainsKey(r.Id)
                                        ? ((Dictionary<int, List<HotelBooking.Models.RoomPrice>>)ViewBag.RoomPricesByRoom)[r.Id]
                                        : new List<HotelBooking.Models.RoomPrice>();
                                    
                                    if (roomPricesForRoom != null && roomPricesForRoom.Any())
                                    {
                                        // Tạo options từ dữ liệu thực trong database
                                        foreach (var roomPrice in roomPricesForRoom)
                                        {
                                            var package = roomPrice.PricePackage;
                                            var packageBreakfast = package?.BreakfastIncluded == true;
                                            var packageCancellation = package?.CancellationPolicy switch
                                            {
                                                "refund_1" => Localizer["RefundableUpTo1Day"].Value,
                                                "refund_3" => Localizer["RefundableUpTo3Days"].Value,
                                                "refund_7" => Localizer["RefundableUpTo7Days"].Value,
                                                "non_refundable" => Localizer["NonRefundable"].Value,
                                                _ => package?.CancellationPolicyDisplayName ?? Localizer["CancellationPolicyApplies"].Value
                                            };
                                            
                                            var optionName = r.Name;
                                            if (package != null && !string.IsNullOrEmpty(package.CancellationPolicyDisplayName))
                                            {
                                                // Có thể thêm suffix dựa trên package nếu cần
                                                optionName = r.Name;
                                            }
                                            
                                            var inclusions = new List<string>();
                                            if (packageBreakfast)
                                            {
                                                inclusions.Add("Bữa sáng cho " + guests + " người");
                                            }
                                            if (!string.IsNullOrEmpty(bedSummary) && bedSummary != Localizer["BedInformation"].Value)
                                            {
                                                inclusions.Add(bedSummary);
                                            }
                                            
                                            // Tính OldPrice (giả sử là 25% cao hơn, hoặc có thể lưu trong database)
                                            var currentPrice = roomPrice.Amount;
                                            var oldPrice = currentPrice * 1.25m;
                                            
                                            roomOptions.Add(new {
                                                Name = optionName,
                                                Inclusions = inclusions,
                                                CancellationPolicy = packageCancellation,
                                                PaymentPolicy = Localizer["PayAtHotel"].Value,
                                                Guests = guests,
                                                OldPrice = (decimal?)oldPrice,
                                                CurrentPrice = (decimal?)currentPrice,
                                                IsSpecial = false,
                                                SpecialLabel = "",
                                                RoomPriceId = roomPrice.Id,  // ID của RoomPrice để truyền sang Booking/Book
                                                PricePackageId = package?.Id  // ID của PricePackage
                                            });
                                        }
                                    }
                                    else if (amount.HasValue)
                                    {
                                        // Fallback: Nếu không có room prices trong database, dùng giá cũ
                                        decimal basePrice = amount.Value;
                                        roomOptions.Add(new {
                                            Name = r.Name,
                                            Inclusions = new[] { 
                                                breakfastIncluded ? "Bữa sáng cho " + guests + " người" : "",
                                                bedSummary
                                            }.Where(x => !string.IsNullOrEmpty(x)).ToList(),
                                            CancellationPolicy = cancellation,
                                            PaymentPolicy = Localizer["PayAtHotel"].Value,
                                            Guests = guests,
                                            OldPrice = (decimal?)(basePrice * 1.25m),
                                            CurrentPrice = (decimal?)basePrice,
                                            IsSpecial = false,
                                            SpecialLabel = ""
                                        });
                                    }
                                    else
                                    {
                                        // Nếu không có giá, chỉ hiển thị 1 option
                                        roomOptions.Add(new {
                                            Name = r.Name,
                                            Inclusions = new[] { bedSummary }.Where(x => !string.IsNullOrEmpty(x)).ToList(),
                                            CancellationPolicy = cancellation,
                                            PaymentPolicy = Localizer["PayAtHotel"].Value,
                                            Guests = guests,
                                            OldPrice = (decimal?)null,
                                            CurrentPrice = (decimal?)null,
                                            IsSpecial = false,
                                            SpecialLabel = ""
                                        });
                                    }
                                }
                                
                                @if (roomOptions.Any())
                                {
                                    <!-- Hiển thị dạng bảng cho cả 1 và nhiều options -->
                                    <div class="room-options-table-wrapper">
                                        <table class="table room-options-table">
                                            <thead>
                                                <tr>
                                                    <th>Lựa chọn phòng</th>
                                                    <th>Khách</th>
                                                    <th>Tổng giá</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var option in roomOptions)
                                                {
                                                    <tr class="room-option-row">
                                                        <td class="option-details-col">
                                                            <div class="option-name">@option.Name</div>
                                                            <div class="option-inclusions">
                                                                @foreach (var inc in option.Inclusions)
                                                                {
                                                                    <div class="inclusion-item">@inc</div>
                                                                }
                                    </div>
                                                            <div class="option-policies">
                                                                @if (!string.IsNullOrEmpty(option.PaymentPolicy))
                                                                {
                                                                    <div class="policy-item">
                                                                        <i class="bi bi-credit-card text-primary"></i>
                                                                        <span>@option.PaymentPolicy</span>
                                    </div>
                                                                }
                                                                @if (!string.IsNullOrEmpty(option.CancellationPolicy))
                                                                {
                                                                    <div class="policy-item">
                                                                        <i class="bi bi-check-circle text-success"></i>
                                                                        <span>@option.CancellationPolicy</span>
                                        </div>
                                    }
                                    </div>
                                                        </td>
                                                        <td class="option-guests-col">
                                                            <div class="option-guests">
                                                                <i class="bi bi-people-fill"></i>
                                                                <span>@option.Guests</span>
                                </div>
                                                        </td>
                                                        <td class="option-price-col">
                                                            <div class="option-price">
                                                                @if (option.IsSpecial && !string.IsNullOrEmpty(option.SpecialLabel))
                                                                {
                                                                    <div class="special-label">@option.SpecialLabel</div>
                                                                }
                                                                @{
                                                                    var oldPrice = option.OldPrice as decimal?;
                                                                    var currentPrice = option.CurrentPrice as decimal?;
                                                                }
                                                                @if (oldPrice.HasValue && currentPrice.HasValue)
                                                                {
                                                                    <div class="old-price">@string.Format("{0:N0} VND", oldPrice.Value)</div>
                                                                    <div class="current-price">@string.Format("{0:N0} VND", currentPrice.Value)</div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="current-price">Giá đang cập nhật</div>
                                                                }
                                                                <div class="price-note">@Localizer["IncludesTaxAndFees"]</div>
                            </div>
                                                            <a class="btn-choose-option"
                                                               asp-controller="Booking"
                                                               asp-action="Book"
                                                               asp-route-propertyId="@Model.Property.Id"
                                                               asp-route-roomId="@r.Id"
                                                               asp-route-checkIn="@checkInDate"
                                                               asp-route-checkOut="@checkOutDate"
                                                               asp-route-roomPriceId="@(option.RoomPriceId ?? 0)"
                                                               asp-route-pricePackageId="@(option.PricePackageId ?? 0)">
                                                                @Localizer["Select"]
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <!-- Fallback nếu không có roomOptions -->
                                <div class="guest-info">
                                    <i class="bi bi-people-fill"></i>
                                    <span>&nbsp;@guests</span>
                                </div>
                                <div class="price-info">
                                    @if(amount.HasValue)
                                    {
                                        <div class="old-price">@string.Format("{0:N0} VND", amount.Value * 1.25m)</div>
                                        <div class="current-price">@string.Format("{0:N0} VND", amount.Value)</div>
                                                                        }
                                        else
                                        {
                                        <div class="current-price">Giá đang cập nhật</div>
                                        }
                                    <div class="price-note">@Localizer["IncludesTaxAndFees"]</div>
                                    </div>
                                    <a class="btn-choose"
                                       asp-controller="Booking"
                                       asp-action="Book"
                                       asp-route-propertyId="@Model.Property.Id"
                                       asp-route-roomId="@r.Id"
                                       asp-route-checkIn="@checkInDate"
                                       asp-route-checkOut="@checkOutDate">
                                        @Localizer["Select"]
                                    </a>
                                }
                                </div>
                            </div>
                        </div>
                        }
                        }
                        else
                        {
                            <div class="alert alert-info">Chưa có phòng nào được cấu hình cho khách sạn này.</div>
                        }
                </div>

<style>
