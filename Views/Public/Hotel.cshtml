            <!-- Rating breakdown -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Vệ sinh</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress" style="width: 150px; height: 8px;">
                                <div class="progress-bar bg-primary" style="width: @((ViewBag.AvgCleanliness ?? 8.7) * 10)%"></div>
                            </div>
                            <span class="fw-bold">@((ViewBag.AvgCleanliness ?? 8.7).ToString("F1"))</span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tiện nghi</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress" style="width: 150px; height: 8px;">
                                <div class="progress-bar bg-primary" style="width: @((ViewBag.AvgService ?? 8.7) * 10)%"></div>
                            </div>
                            <span class="fw-bold">@((ViewBag.AvgService ?? 8.7).ToString("F1"))</span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Phòng</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress" style="width: 150px; height: 8px;">
                                <div class="progress-bar bg-primary" style="width: @((ViewBag.AvgRating ?? 8.9) * 10)%"></div>
                            </div>
                            <span class="fw-bold">@((ViewBag.AvgRating ?? 8.9).ToString("F1"))</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Đồ ăn</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress" style="width: 150px; height: 8px;">
                                <div class="progress-bar bg-primary" style="width: @((ViewBag.AvgValue ?? 8.4) * 10)%"></div>
                            </div>
                            <span class="fw-bold">@((ViewBag.AvgValue ?? 8.4).ToString("F1"))</span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Vị trí</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress" style="width: 150px; height: 8px;">
                                <div class="progress-bar bg-primary" style="width: @((ViewBag.AvgLocation ?? 8.6) * 10)%"></div>
                            </div>
                            <span class="fw-bold">@((ViewBag.AvgLocation ?? 8.6).ToString("F1"))</span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Dịch vụ và Tiện ích</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress" style="width: 150px; height: 8px;">
                                <div class="progress-bar bg-primary" style="width: @((ViewBag.AvgService ?? 8.7) * 10)%"></div>
                            </div>
                            <span class="fw-bold">@((ViewBag.AvgService ?? 8.7).ToString("F1"))</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Review categories -->
            <div class="mb-3">
                <strong>@Localizer["SelectTopicToReadReviews"]</strong>
            </div>
            <div class="review-categories mb-4">
                <button class="category-btn">+ @Localizer["Breakfast"]</button>
                <button class="category-btn">+ @Localizer["Dinner"]</button>
                <button class="category-btn">+ @Localizer["Room"]</button>
                <button class="category-btn">+ @Localizer["SwimmingPool"]</button>
                <button class="category-btn">+ @Localizer["Location"]</button>
            </div>

            <!-- Individual reviews -->
            <div class="mb-3">
                <strong>Đánh giá của khách hàng</strong>
            </div>

            @{
                var reviews = ViewBag.Reviews as List<HotelBooking.ViewModels.HotelReviewViewModel> ?? new List<HotelBooking.ViewModels.HotelReviewViewModel>();
                var initialReviews = reviews.Take(5).ToList();
                var remainingReviews = reviews.Skip(5).ToList();
            }

            <div class="reviews-list">
                @for (int i = 0; i < reviews.Count; i++)
                {
                    var review = reviews[i];
                    var avatarColors = new[] { "bg-primary", "bg-success", "bg-warning", "bg-info", "bg-danger" };
                    var colorIndex = review.Initials.GetHashCode() % avatarColors.Length;
                    if (colorIndex < 0) colorIndex = -colorIndex;
                    var avatarColor = avatarColors[colorIndex];
                    var isHidden = i >= 5 ? "d-none" : "";
                    
                    <div class="review-item mb-4 p-3 border rounded @isHidden" data-review-index="@i">
                        <div class="d-flex align-items-start gap-3 mb-2">
                            <div class="avatar-circle @avatarColor text-white" style="width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 18px;">
                                @review.Initials
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <div class="fw-bold">@review.Name</div>
                                    @if (review.IsBusiness)
                                    {
                                        <span class="badge bg-secondary small">
                                            <i class="bi bi-briefcase"></i> Công tác
                                        </span>
                                    }
                        </div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    @{
                                        var starRating = review.Rating / 2.0m; // Convert from 0-10 to 0-5 stars
                                        var fullStars = (int)Math.Floor((double)starRating);
                                        var hasHalfStar = starRating - fullStars >= 0.5m;
                                    }
                                    <div class="d-flex align-items-center gap-1">
                                        @for (int s = 0; s < 5; s++)
                                        {
                                            if (s < fullStars)
                                            {
                                                <i class="bi bi-star-fill text-warning" style="font-size: 1.1rem;"></i>
                                            }
                                            else if (s == fullStars && hasHalfStar)
                                            {
                                                <i class="bi bi-star-half text-warning" style="font-size: 1.1rem;"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-warning" style="font-size: 1.1rem;"></i>
                                            }
                                        }
                                    </div>
                                    <span class="text-muted small">Đánh giá cách đây @review.TimeAgo</span>
                    </div>
                                <p class="mb-2" style="line-height: 1.6;">@review.Comment</p>
                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-sm btn-outline-secondary" style="border: none; padding: 4px 8px;">
                                        <i class="bi bi-hand-thumbs-up"></i> Đánh giá này hữu ích không?
                                    </button>
                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (reviews.Count > 5)
            {
            <div class="text-center mt-4">
                    <button id="showAllReviewsBtn" class="btn btn-outline-primary">
                        Xem tất cả đánh giá (@(reviews.Count - 5) thêm)
                    </button>
            </div>
            }
        </div>
    </div> <!-- end container -->

