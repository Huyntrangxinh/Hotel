            <li class="nav-item"><a class="nav-link" href="#">@Localizer["GeneralRules"]</a></li>
            <li class="nav-item"><a class="nav-link" href="#">@Localizer["GuestReviews"] (327)</a></li>
            <li class="nav-item ms-auto"><a class="nav-link" href="#"><i class="bi bi-heart"></i></a></li>
            <li class="nav-item"><a class="nav-link" href="#"><i class="bi bi-share"></i></a></li>
        </ul>

        <!-- Tiêu đề khách sạn và các nút hành động -->
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <div class="star-rating mb-2">
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <span class="badge bg-warning text-dark ms-2"><i class="bi bi-flag"></i> Travel Proud</span>
                </div>
            <h1 class="mb-1">@Model.Property.Name</h1>
                <div class="hotel-address">
                <i class="bi bi-geo-alt"></i> @Model.Property.AddressLine, @Model.Property.PostalCode
                @Model.Property.City, @Model.Property.CountryCode
                    - <a href="#">@Localizer["ExcellentLocation"] - @Localizer["ShowOnMap"]</a>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="text-end me-3">
                    <div class="mb-1">
                        <span class="badge bg-info text-white">@Localizer["WeAlwaysMatchPrices"]</span>
                    </div>
                    <button class="btn btn-primary fw-bold px-4">@Localizer["BookNow"]</button>
                </div>
            </div>
        </div>

        <div class="row equal-row">
        <div class="col-12">
            <!-- Photos: New Layout -->
            <div class="photo-gallery mb-4">
                <!-- Ảnh chính bên trái -->
                <div class="gallery-item gallery-main" onclick="openFullGallery()">
                        <img src="@(Model.PhotoUrls.Count > 0 ? Model.PhotoUrls[0] : "/images/placeholder.jpg")"
                        alt="Main hotel view" class="hotel-photo-thumb">
                    </div>

                <!-- 6 ảnh nhỏ bên phải -->
                <div class="gallery-grid">
                    @{
                        var photoCount = Model.PhotoUrls?.Count ?? 0;
                    }
                    @if (photoCount > 6)
                    {
                        @* Hiển thị 5 ảnh đầu + 1 ảnh cuối với overlay *@
                        @for (int i = 1; i <= 5 && i < photoCount; i++)
                        {
                            <div class="gallery-item" onclick="openFullGallery()">
                                <img src="@Model.PhotoUrls[i]" alt="Hotel photo @i" class="hotel-photo-thumb">
                                </div>
                            }
                        @* Ảnh cuối với overlay "Xem tất cả" *@
                        <div class="gallery-item view-all" onclick="openFullGallery()">
                            <img src="@Model.PhotoUrls[photoCount - 1]" alt="View all photos"
                                class="hotel-photo-thumb">
                            <div class="photo-overlay-permanent">
                                <div class="overlay-content">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                        <polyline points="21 15 16 10 5 21"></polyline>
                                    </svg>
                                    <div>@Localizer["ViewAllImages"]</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Hiển thị tất cả ảnh (≤ 6) *@
                        @for (int i = 1; i < photoCount; i++)
                        {
                            <div class="gallery-item" onclick="openFullGallery()">
                                <img src="@Model.PhotoUrls[i]" alt="Hotel photo @i" class="hotel-photo-thumb">
                                </div>
                            }
                    }
                    @* Tạo placeholder cho các ô trống nếu cần *@
                    @if (photoCount <= 6)
                    {
                        @for (int i = photoCount; i <= 6; i++)
                        {
                            <div class="gallery-item">
                                <div class="d-flex align-items-center justify-content-center bg-light border rounded h-100">
                                    <i class="bi bi-image text-muted fs-4"></i>
                        </div>
                            </div>
                        }
                    }
                    </div>
                </div>

                <!-- Amenities -->
                <div class="amenities-grid mb-4">
                    @if (ViewBag.PropertyAmenities != null && ((List<(string Name, string Icon, string LocalizerKey)>)ViewBag.PropertyAmenities).Count > 0)
                    {
                        @foreach (var amenity in (List<(string Name, string Icon, string LocalizerKey)>)ViewBag.PropertyAmenities)
                        {
                            <div class="amenity-item">
                                <i class="bi @amenity.Icon"></i>
                                @{
                                    string displayText = amenity.Name;
                                    try
                                    {
                                        var localized = Localizer[amenity.LocalizerKey];
                                        if (localized != null && !string.IsNullOrEmpty(localized.Value))
                                        {
                                            displayText = localized.Value;
                                        }
                                    }
                                    catch
                                    {
                                        // Use Name if localization fails
                                    }
                                }
                                <span>@displayText</span>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Fallback: Show default amenities if no PropertyData amenities -->
                    <div class="amenity-item">
                        <i class="bi bi-water"></i>
                        <span>@Localizer["MountainView"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-tree"></i>
                        <span>@Localizer["Garden"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-water"></i>
                        <span>@Localizer["SwimmingPool"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-wifi"></i>
                        <span>@Localizer["FreeWiFi"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-door-open"></i>
                        <span>@Localizer["Terrace"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-people"></i>
                        <span>@Localizer["Balcony"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-p-circle"></i>
                        <span>@Localizer["FreeParking"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-droplet"></i>
                        <span>@Localizer["Bathtub"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-snow"></i>
                        <span>@Localizer["AirConditioning"]</span>
                    </div>
                    <div class="amenity-item">
                        <i class="bi bi-clock"></i>
