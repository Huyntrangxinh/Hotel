        <!-- Reviews Section -->
        <div class="content-section mt-4">
            <div class="section-title">Đánh giá của du khách về @Model.Property.Name</div>
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white p-4 rounded" style="min-width: 80px; text-align: center;">
                        <div class="h2 mb-0 fw-bold">@(ViewBag.AvgRating != null ? ((double)ViewBag.AvgRating).ToString("F1") : "8,9")</div>
                    </div>
                    <div>
                        <div class="fw-bold fs-5">@(ViewBag.AvgRating >= 8.5 ? "Rất tốt" : ViewBag.AvgRating >= 7.0 ? "Tốt" : "Khá")</div>
                        <div class="text-muted">Từ @(ViewBag.TotalReviews ?? 10) đánh giá</div>
