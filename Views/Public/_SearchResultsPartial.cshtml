@model HotelBooking.ViewModels.PublicSearchResultsViewModel
@inject IStringLocalizer<SharedResource> Localizer

@foreach (var p in Model.Properties)
{
    var photoUrl = Model.MainPhotoUrls.TryGetValue(p.Id, out var url)
        ? url
        : "/img/recent.jpg";
    var minPrice = Model.MinPriceByProperty.ContainsKey(p.Id)
        ? Model.MinPriceByProperty[p.Id]
        : 0;
    var propertyLink = Url.Action("Hotel", "Public", new
    {
        id = p.Id,
        checkin = Model.Checkin?.ToString("yyyy-MM-dd"),
        checkout = Model.Checkout?.ToString("yyyy-MM-dd"),
        adults = ViewBag.SearchAdults,
        children = ViewBag.SearchChildren,
        rooms = ViewBag.SearchRooms
    });
    <div class="hotel-card">
        <div class="hotel-image" style="background-image: url('@photoUrl');">
            <button class="heart-btn"
                    type="button"
                    aria-label="Yêu thích"
                    data-property-id="@p.Id"
                    data-property-name="@p.Name"
                    data-property-city="@p.City"
                    data-property-address="@p.AddressLine"
                    data-property-price="@minPrice"
                    data-property-image="@photoUrl"
                    data-property-url="@propertyLink">
                <i class="bi bi-heart"></i>
                <i class="bi bi-heart-fill"></i>
            </button>
        </div>
        <div class="hotel-details">
            <h2 class="hotel-name">@p.Name
                @{
                    int stars = Model.StarRatingByProperty != null &&
                    Model.StarRatingByProperty.ContainsKey(p.Id) &&
                    Model.StarRatingByProperty[p.Id].HasValue ?
                    Model.StarRatingByProperty[p.Id]!.Value : 0;
                }
                <span class="hotel-stars">@(new string('★', stars))</span>
            </h2>
            <div class="hotel-location">@p.City</div>
            <div class="distance">@p.AddressLine</div>
            @{
                HotelBooking.Models.Room fr;
                Model.FeaturedRoomByProperty.TryGetValue(p.Id, out fr);
            }
            @if (fr != null)
            {
                var totalBeds = fr.Beds?.Sum(b => (int)b.Count) ?? 0;
                <div class="small text-muted"><strong>@fr.Name</strong> • <span class="nowrap">@totalBeds
                        @Localizer["Beds"]</span></div>
            }
            @{
                bool? bf = null;
                if (Model.BreakfastIncludedByProperty != null &&
                Model.BreakfastIncludedByProperty.ContainsKey(p.Id))
                {
                    bf = Model.BreakfastIncludedByProperty[p.Id];
                }
            }
            @if (bf == true)
            {
                <div class="promotion" style="color:#008009">@Localizer["IncludesBreakfast"]</div>
            }
            else
            {
                <div class="promotion" style="color:#d91e18">@Localizer["DoesNotIncludeBreakfast"]</div>
            }
            <div class="limited-offer">@Localizer["LimitedRoomsMessage"]</div>
        </div>
        <div class="hotel-booking-info">
            <div class="rating-section">
                <div class="rating-text">
                    <div class="rating-label">@Localizer["Excellent"]</div>
                    <div class="review-count">328 @Localizer["Reviews"]</div>
                    <div class="location-score">@Localizer["Location"] 9,3</div>
                </div>
                <div class="rating-score">8,9</div>
            </div>
            <div>
                <div class="guests-info">1 @Localizer["Night"], 2 @Localizer["Adults"]</div>
                <div class="price">VND @String.Format("{0:N0}", Model.MinPriceByProperty.ContainsKey(p.Id) ?
                                    Model.MinPriceByProperty[p.Id] : 0)</div>
            <div class="price-includes">+VND 469.000 @Localizer["TaxAndFees"]</div>
            <a class="book-btn" href="@propertyLink">@Localizer["ViewAvailability"]</a>
        </div>
    </div>
</div>
}
