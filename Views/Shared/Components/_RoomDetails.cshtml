@model HotelBooking.ViewModels.Rooms.RoomCreateViewModel
@inject IStringLocalizer<SharedResource> Localizer

<section id="sec-detail" class="tera-card mb-3">
    <div class="section-head">
        <h3 class="tera-title">@Localizer["RoomDetails"]</h3>
        <p class="tera-desc">@Localizer["RoomDetailsDescription"]</p>
    </div>

    <!-- Hàng: Kích cỡ phòng / đơn vị + Kích cỡ + Đơn vị -->
    <div class="row g-3 align-items-start">
        <div class="col-md-3">
            <label class="form-label form-label-lg mb-1">@Localizer["RoomSizeUnit"]</label>
            <div class="form-hint">@Localizer["RoomSizeHint"]</div>
        </div>
        <div class="col-md-4">
            <label class="form-label mb-1">@Localizer["Size"]</label>
            <input asp-for="SizeNumber" type="number" min="1" class="form-control form-control-sm"
                placeholder="@Localizer["EnterNumber"]" />
            <span class="text-danger small" asp-validation-for="SizeNumber"></span>
        </div>
        <div class="col-md-5">
            <label class="form-label mb-1">@Localizer["Unit"]</label>
            <select asp-for="SizeUnit" class="form-select form-select-sm">
                <option value="" disabled selected>@Localizer["EnterUnit"]</option>
                <option value="m2">m²</option>
                <option value="ft2">ft²</option>
            </select>
            <span class="text-danger small" asp-validation-for="SizeUnit"></span>
        </div>
    </div>

    <!-- Hàng: Hút thuốc -->
    <div class="row g-3 align-items-center mt-2">
        <div class="col-md-3">
            <label class="form-label form-label-lg mb-0">@Localizer["Smoking"]</label>
        </div>
        <div class="col-md-9">
            <div class="d-flex gap-4 align-items-center">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SmokingAllowed" value="false"
                        @(Model.SmokingAllowed ? "" : "checked") />
                    <label class="form-check-label">@Localizer["NoSmoking"]</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="SmokingAllowed" value="true"
                        @(Model.SmokingAllowed ? "checked" : "") />
                    <label class="form-check-label">@Localizer["Allow"]</label>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng: Quỹ phòng -->
    <div class="row g-3 align-items-start mt-2">
        <div class="col-md-3">
            <label class="form-label form-label-lg mb-1">@Localizer["RoomInventory"]</label>
            <div class="form-hint">@Localizer["RoomInventoryHint"]</div>
        </div>
        <div class="col-md-9">
            <input asp-for="Quantity" type="number" min="1" class="form-control form-control-sm"
                placeholder="@Localizer["EnterNumber"]" />
            <span class="text-danger small" asp-validation-for="Quantity"></span>
        </div>
    </div>
</section>
