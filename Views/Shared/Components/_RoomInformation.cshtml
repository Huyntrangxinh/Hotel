@model HotelBooking.ViewModels.Rooms.RoomCreateViewModel
@inject IStringLocalizer<SharedResource> Localizer

<section id="sec-info" class="tera-card mb-3">
    <div class="section-head">
        <h3 class="tera-title">@Localizer["RoomInformation"]</h3>
        <p class="tera-desc">@Localizer["RoomInformationDescription"]</p>
    </div>

    <div class="row g-3 align-items-center">
        <div class="col-md-3">
            <label class="form-label form-label-lg mb-0">@Localizer["RoomType"]</label>
        </div>
        <div class="col-md-9">
            <select asp-for="RoomType" class="form-select form-select-sm">
                <option value="">@Localizer["SelectRoomType"]</option>
                @foreach (var t in Model.RoomTypes)
                {
                    <option>@t</option>
                }
            </select>
            <span class="text-danger small" asp-validation-for="RoomType"></span>
        </div>

        <div class="col-md-3">
            <label class="form-label form-label-lg mb-0">@Localizer["RoomName"]</label>
        </div>
        <div class="col-md-9">
            <input asp-for="RoomName" class="form-control form-control-sm" placeholder="@Localizer["EnterRoomName"]" />
            <span class="text-danger small" asp-validation-for="RoomName"></span>
        </div>
    </div>
</section>
