@model HotelBooking.ViewModels.Rooms.RoomCreateViewModel
@inject IStringLocalizer<SharedResource> Localizer

<section id="sec-photos" class="tera-card mb-3">
    <div class="section-head">
        <h3 class="tera-title">@Localizer["RoomPhotos"]</h3>
        <p class="tera-desc">@Localizer["RoomPhotosDescription"]</p>
        <a href="#" class="text-primary small">@Localizer["ViewPhotoGuidelines"]</a>
    </div>

    <!-- Yêu cầu về ảnh -->
    <div class="photo-requirements mb-4">
        <h6 class="fw-semibold mb-2">@Localizer["PhotoRequirements"]</h6>
        <ul class="list-unstyled small text-muted">
            <li>• @Localizer["ResolutionRequirement"]</li>
            <li>• @Localizer["SizeRequirement"]</li>
        </ul>
    </div>

    <!-- Khu vực tải ảnh -->
    <div class="row g-4">
        <!-- Bedroom -->
        <div class="col-md-6">
            <div class="upload-zone" id="bedroomUpload">
                <div class="upload-content text-center">
                    <i class="bi bi-camera fs-1 text-muted mb-2"></i>
                    <h6 class="mb-2">@Localizer["Bedroom"]</h6>
                    <span class="btn btn-link p-0 text-primary">@Localizer["UploadPhoto"]</span>
                </div>
                <input type="file" name="BedroomPhotos" id="bedroomPhotos" multiple accept="image/*"
                    class="upload-input" />
            </div>
            <div id="bedroomError" class="photo-error text-danger small d-none">@Localizer["ThisFieldIsRequired"]</div>
        </div>

        <!-- Bathroom -->
        <div class="col-md-6">
            <div class="upload-zone" id="bathroomUpload">
                <div class="upload-content text-center">
                    <i class="bi bi-camera fs-1 text-muted mb-2"></i>
                    <h6 class="mb-2">@Localizer["Bathroom"]</h6>
                    <span class="btn btn-link p-0 text-primary">@Localizer["UploadPhoto"]</span>
                </div>
                <input type="file" name="BathroomPhotos" id="bathroomPhotos" multiple accept="image/*"
                    class="upload-input" />
            </div>
            <div id="bathroomError" class="photo-error text-danger small d-none">@Localizer["ThisFieldIsRequired"]</div>
        </div>
    </div>

    <!-- Khu vực tải ảnh bổ sung -->
    <div class="row g-4 mt-3">
        <div class="col-12">
            <!-- Khu vực tải ảnh lớn (khi chưa có ảnh) -->
            <div class="upload-zone upload-zone-large" id="additionalUploadLarge">
                <div class="upload-content text-center">
                    <i class="bi bi-camera fs-1 text-muted mb-2"></i>
                    <h6 class="mb-2">@Localizer["UploadMorePhotos"]</h6>
                    <small class="text-muted d-block">@Localizer["AdditionalPhotosDescription"]</small>
                </div>
                <input type="file" name="AdditionalPhotos" id="additionalPhotos" multiple accept="image/*"
                    class="upload-input" />
            </div>

            <!-- Lưới ảnh thumbnail (khi đã có ảnh) -->
            <div id="additionalPhotosGrid" class="d-none">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-semibold mb-0">@Localizer["AdditionalPhotos"]</h6>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddMorePhotos">
                        <i class="bi bi-plus-lg me-1"></i>@Localizer["UploadMorePhotos"]
                    </button>
                </div>
                <div class="row g-3" id="additionalPhotosContainer">
                    <!-- Ảnh thumbnail sẽ được render ở đây -->
                </div>
                <input type="file" name="MoreAdditionalPhotos" id="moreAdditionalPhotos" multiple accept="image/*"
                    class="d-none" />
            </div>
        </div>
    </div>
</section>
