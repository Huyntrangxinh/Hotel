@model HotelBooking.ViewModels.Rooms.RoomCreateViewModel
@inject IStringLocalizer<SharedResource> Localizer

<section id="sec-security" class="tera-card mb-3">
    <div class="section-head">
        <h3 class="tera-title">@Localizer["SecurityDeposit"]</h3>
        <p class="tera-desc">@Localizer["SecurityDepositDescription"]</p>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label form-label-lg mb-1">@Localizer["MinimumPrice"]</label>
            <div class="input-group">
                <span class="input-group-text">VND</span>
                <input type="hidden" asp-for="SecurityDeposit" id="SecurityDeposit"
                    value="@Model.SecurityDeposit?.ToString().Split('.')[0]" />
                <input type="text" id="SecurityDepositDisplay" class="form-control form-control-sm"
                    placeholder="@Localizer["EnterPrice"]" inputmode="numeric" autocomplete="off" />
            </div>
            <span class="text-danger small" asp-validation-for="SecurityDeposit"></span>
        </div>
    </div>
</section>
