@model HotelBooking.ViewModels.BookingViewModel
@using System.Text.Json
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["BookRoom"] + " - " + Model.PropertyName;
}

<div class="booking-page">
    <div class="container py-4">
        <!-- Header -->
        <div class="mb-4">
            <h4 class="mb-2">@Model.PropertyName</h4>
            <div class="d-flex align-items-center">
                <div class="stars me-2">
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                </div>
                <span class="rating-text">4.8 (237)</span>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column - Booking Form -->
            <div class="col-lg-7">


                <form asp-action="Book" method="post" id="bookingForm">
                    <input type="hidden" asp-for="PropertyId" />
                    <input type="hidden" asp-for="RoomId" />
                    <input type="hidden" asp-for="CheckIn" />
                    <input type="hidden" asp-for="CheckOut" />
                    <input type="hidden" asp-for="Guests" />
                    <input type="hidden" asp-for="PricePerNight" />
                    <input type="hidden" asp-for="TotalNights" />
                    <input type="hidden" asp-for="TotalPrice" />

                    <!-- Discount fields -->
                    <input type="hidden" asp-for="DiscountCode" id="discountCodeHidden" />
                    <input type="hidden" asp-for="DiscountAmount" id="discountAmountHidden" />
                    <input type="hidden" asp-for="DiscountPercentage" id="discountPercentageHidden" />

                    <!-- Contact Information Card -->
                    <div class="booking-card mb-3">
                        <div class="card-header">
                            <i class="bi bi-person-circle me-2"></i>
                            <span>@Localizer["ContactBooking"]</span>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">@Localizer["AddContactForConfirmation"]</p>

                            <div class="mb-3">
                                <label class="form-label">@Localizer["FullName"]*</label>
                                <input asp-for="FullName" class="form-control"
                                    placeholder="@Localizer["FullNamePlaceholder"]" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Localizer["MobilePhone"]*</label>
                                    <div class="phone-input-group">
                                        <select class="country-code">
                                            <option value="+84">🇻🇳 +84</option>
                                        </select>
                                        <input asp-for="PhoneNumber" class="form-control phone-input"
                                            placeholder="@Localizer["PhonePlaceholder"]" />
                                    </div>
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Localizer["Email"]*</label>
                                    <input asp-for="Email" class="form-control"
                                        placeholder="@Localizer["EmailPlaceholder"]" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="bookingForMyself" checked>
                                <label class="form-check-label" for="bookingForMyself">
                                    @Localizer["BookingForMyself"]
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Guest Information Card -->
                    <div class="booking-card mb-3">
                        <div class="card-header">
                            <i class="bi bi-people me-2"></i>
                            <span>@Localizer["GuestInformation"]</span>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">@Localizer["FillCompleteInfo"]</p>

                            <div class="mb-3">
                                <label class="form-label">@Localizer["FullName"]*</label>
                                <input asp-for="GuestName" class="form-control"
                                    placeholder="@Localizer["FullNamePlaceholder"]" />
                                <span asp-validation-for="GuestName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Special Requests Card -->
                    <div class="booking-card mb-3">
                        <div class="card-header">
                            <i class="bi bi-chat-left-text me-2"></i>
                            <span>@Localizer["SpecialRequests"]</span>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">
                                @Localizer["SpecialRequestsDescription"]
                            </p>

                            <div class="row mb-3">
                                <div class="col-md-4 mb-2">
                                    <div class="form-check">
                                        <input asp-for="NonSmokingRoom" class="form-check-input" type="checkbox">
                                        <label asp-for="NonSmokingRoom" class="form-check-label">
                                            @Localizer["NonSmokingRoom"]
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <div class="form-check">
                                        <input asp-for="ConnectingRoom" class="form-check-input" type="checkbox">
                                        <label asp-for="ConnectingRoom" class="form-check-label">
                                            @Localizer["ConnectingRoom"]
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <div class="form-check">
                                        <input asp-for="HighFloor" class="form-check-input" type="checkbox">
                                        <label asp-for="HighFloor" class="form-check-label">
                                            @Localizer["HighFloor"]
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="form-label">@Localizer["OtherRequests"]</label>
                                <textarea asp-for="SpecialRequests" class="form-control" rows="3"
                                    placeholder="@Localizer["SpecialRequestsPlaceholder"]"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Accommodation Policy Card -->
                    <div class="booking-card mb-3">
                        <div class="card-header">
                            <i class="bi bi-file-text me-2"></i>
                            <span>@Localizer["AccommodationPolicy"]</span>
                            <a href="#" class="ms-auto text-primary" data-bs-toggle="modal"
                                data-bs-target="#policyModal">
                                @Localizer["ReadAll"]
                            </a>
                        </div>
                        <div class="card-body">
                            <div class="policy-item">
                                <i class="bi bi-sun policy-icon"></i>
                                <div>
                                    <strong>@Localizer["Breakfast"]</strong>
                                    <p class="mb-0 text-muted small">@Localizer["BreakfastDescription"]</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Insurance Banner -->
                    <div class="insurance-banner mb-3">
                        <img src="/images/anhgiadinh.webp" alt="Gia đình du lịch" class="family-icon" />
                        <div>
                            <h6 class="mb-1">@Localizer["CreateMemories"]</h6>
                        </div>
                    </div>

                    <!-- Travel Insurance Card -->
                    <div class="booking-card mb-3">
                        <div class="card-body">
                            <div class="d-flex align-items-start">
                                <input type="checkbox" class="form-check-input me-3 mt-1">
                                <div class="flex-grow-1">
                                    <strong>@Localizer["TravelInsurance"]</strong>
                                    <p class="text-muted small mb-2">@Localizer["TravelInsuranceDescription"]</p>
                                    <a href="#" class="text-primary small">@Localizer["Information"]</a>
                                </div>
                                <div class="text-end ms-3">
                                    <strong>VND43.500</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Terms and Conditions -->
                    <div class="form-check mb-4">
                        <input asp-for="AgreeToTerms" class="form-check-input" type="checkbox" required>
                        <label asp-for="AgreeToTerms" class="form-check-label small">
                            @Localizer["AgreeToTerms"]
                            <a href="#" class="text-primary">@Localizer["TermsAndConditions"]</a>,
                            <a href="#" class="text-primary">@Localizer["PrivacyPolicy"]</a>,
                            và <a href="#" class="text-primary">@Localizer["RefundPolicy"]</a> của Traveloka.
                        </label>
                        <span asp-validation-for="AgreeToTerms" class="text-danger"></span>
                    </div>
                </form>
            </div>

            <!-- Right Column - Booking Summary -->
            <div class="col-lg-5">
                <div class="summary-card sticky-top">
                    <div class="room-info-banner mb-3">

                        <div class="booking-selection mb-3">
                            <div class="room-name mb-2">
                                <strong>(1x) @Model.RoomName</strong>
                            </div>
                        </div>

                        <div class="booking-dates">
                            <div class="row g-0">
                                <div class="col-5">
                                    <div class="date-box">
                                        <div class="date-label">@Localizer["CheckIn"]</div>
                                        <div class="date-main">@Model.CheckIn.ToString("dddd, dd MMMM",
                                                                                        System.Globalization.CultureInfo.CurrentCulture)</div>
                                        <div class="date-year">@Model.CheckIn.ToString("yyyy")</div>
                                        <div class="date-time">@Localizer["From"] 14:00</div>
                                    </div>
                                </div>
                                <div class="col-2 text-center d-flex align-items-center justify-content-center">
                                    <div class="nights-badge">
                                        <i class="bi bi-moon-fill"></i>
                                        <span>@Model.TotalNights @Localizer["Nights"]</span>
                                    </div>
                                </div>
                                <div class="col-5">
                                    <div class="date-box">
                                        <div class="date-label">@Localizer["CheckOut"]</div>
                                        <div class="date-main">@Model.CheckOut.ToString("dddd, dd MMMM",
                                                                                        System.Globalization.CultureInfo.CurrentCulture)</div>
                                        <div class="date-year">@Model.CheckOut.ToString("yyyy")</div>
                                        <div class="date-time">@Localizer["Before"] 12:00</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="room-details mt-3">
                            <div class="detail-item">
                                <i class="bi bi-people-fill"></i>
                                <span>@Model.Guests @Localizer["Guests"], 1 @Localizer["Children"] (8
                                    @Localizer["YearsOld"])</span>
                            </div>
                            <div class="detail-item">
                                <i class="bi bi-info-circle-fill text-primary"></i>
                                <a href="#" class="text-primary">@Localizer["ChildFeeDetails"]</a>
                            </div>
                            <div class="detail-item">
                                <i class="bi bi-shield-fill-check text-success"></i>
                                <span>@Localizer["NonRefundable"]</span>
                            </div>
                            <div class="detail-item">
                                <i class="bi bi-x-circle-fill text-muted"></i>
                                <span>@Localizer["NonReschedulable"]</span>
                            </div>
                            <div class="detail-item mt-2">
                                <span>💳 🏦</span>
                            </div>
                        </div>
                    </div>

                    <div class="info-note mb-3">
                        <i class="bi bi-info-circle text-primary"></i>
                        <small class="text-muted">
                            @Localizer["TaxAndFeesNote"]
                        </small>
                    </div>

                    <!-- Price Details -->
                    <div class="price-section">
                        <div class="price-header mb-3">
                            <i class="bi bi-tag-fill"></i>
                            <strong>@Localizer["PriceDetails"]</strong>
                            <button class="btn-collapse ms-auto" type="button" data-bs-toggle="collapse"
                                data-bs-target="#priceDetails">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                        </div>

                        <div class="collapse show" id="priceDetails">
                            <div class="price-row">
                                <span>@Localizer["RoomPrice"]</span>
                                <span>@( (Model.PricePerNight * Model.TotalNights).ToString("N0") ) VND</span>
                            </div>
                            <div class="price-subtext">
                                <span>(1x) @Model.RoomName (@Model.TotalNights @Localizer["Nights"])</span>
                            </div>
                            <div class="price-row mt-2">
                                <span>@Localizer["TaxAndFees"]</span>
                                <span>@((Model.TotalPrice * 0.1m).ToString("N0")) VND</span>
                            </div>

                            <!-- Discount Code Section -->
                            <div class="discount-section mt-3">
                                <div class="d-flex gap-2">
                                    <div class="flex-grow-1">
                                        <input type="text" id="discountCode" class="form-control" style="text-transform: uppercase;"
                                            placeholder="@Localizer["EnterDiscountCode"]" maxlength="20">
                                    </div>
                                    <button type="button" id="applyDiscount"
                                        class="btn btn-outline-primary">@Localizer["Apply"]</button>
                                </div>
                                <div id="discountMessage" class="mt-2 small"></div>
                            </div>

                            <!-- Discount Row (hidden by default) -->
                            <div id="discountRow" class="price-row text-success" style="display: none;">
                                <span>@Localizer["Discount"]</span>
                                <span id="discountAmount">0 VND</span>
                            </div>

                            <div class="price-divider"></div>

                            <div class="price-row-total mb-2">
                                <span>@Localizer["Total"]</span>
                            </div>
                            <div class="price-breakdown mb-2">
                                <span>1 @Localizer["Room"], @Model.TotalNights @Localizer["Nights"]</span>
                                <span class="text-muted text-decoration-line-through">@((Model.PricePerNight *
                                                                        Model.TotalNights * 1.1m).ToString("N0")) VND</span>
                            </div>
                        </div>

                        <div class="final-price-row">
                            <strong class="final-price" id="finalPrice">@(((Model.PricePerNight * Model.TotalNights) *
                                                                1.1m).ToString("N0")) VND</strong>
                        </div>
                    </div>

                    <!-- Continue Button -->
                    <button type="submit" form="bookingForm" class="btn btn-primary btn-continue">
                        @Localizer["Continue"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .booking-page {
        background-color: #f5f7fa;
        min-height: 100vh;
    }

    .stars i {
        color: #FFB400;
        font-size: 14px;
    }

    .rating-text {
        color: #687176;
        font-size: 14px;
    }

    .alert-banner {
        background: #E3F2FD;
        border: 1px solid #BBDEFB;
        border-radius: 12px;
        padding: 16px;
        display: flex;
        align-items: center;
        font-size: 14px;
    }

    .alert-icon {
        width: 40px;
        height: 40px;
        margin-right: 12px;
    }

    .btn-link {
        color: #0194F3;
        text-decoration: none;
        font-weight: 500;
    }

    .btn-link-info {
        color: #0194F3;
        text-decoration: none;
    }

    .booking-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .card-header {
        background: white;
        padding: 16px 20px;
        border-bottom: 1px solid #E8EAED;
        display: flex;
        align-items: center;
        font-weight: 600;
        font-size: 15px;
    }

    .card-header i {
        font-size: 20px;
        color: #0194F3;
    }

    .card-body {
        padding: 20px;
    }

    .form-label {
        font-size: 14px;
        font-weight: 500;
        color: #1C1C1C;
        margin-bottom: 8px;
    }

    .form-control {
        border: 1px solid #DFE1E6;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 14px;
    }

    .form-control:focus {
        border-color: #0194F3;
        box-shadow: 0 0 0 3px rgba(1, 148, 243, 0.1);
    }

    .phone-input-group {
        display: flex;
        gap: 8px;
    }

    .country-code {
        width: 100px;
        border: 1px solid #DFE1E6;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 14px;
    }

    .phone-input {
        flex: 1;
    }

    .form-check-input:checked {
        background-color: #0194F3;
        border-color: #0194F3;
    }

    .policy-item {
        display: flex;
        align-items: start;
        gap: 12px;
        background: #F5F7FA;
        padding: 16px;
        border-radius: 8px;
    }

    .policy-icon {
        font-size: 24px;
        color: #FFB400;
    }

    .insurance-banner {
        background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .family-icon {
        width: 60px;
        height: 60px;
    }

    .summary-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        top: 20px;
    }

    .badge {
        font-size: 11px;
        padding: 4px 8px;
        font-weight: 500;
    }

    .btn-link-small {
        font-size: 13px;
        color: #0194F3;
        text-decoration: none;
    }

    .room-info-banner {
        background: #F8F9FA;
        padding: 16px;
        border-radius: 8px;
        border: 1px solid #E8EAED;
    }

    .booking-selection {
        padding-bottom: 12px;
        border-bottom: 1px solid #E8EAED;
    }

    .room-name {
        font-size: 14px;
        color: #1C1C1C;
    }

    .booking-dates {
        margin-top: 12px;
    }

    .date-box {
        padding: 8px;
    }

    .date-label {
        font-size: 11px;
        color: #687176;
        margin-bottom: 4px;
    }

    .date-main {
        font-weight: 600;
        font-size: 12px;
        color: #1C1C1C;
        margin-bottom: 2px;
    }

    .date-year {
        font-size: 11px;
        color: #687176;
        margin-bottom: 2px;
    }

    .date-time {
        font-size: 11px;
        color: #687176;
    }

    .nights-badge {
        background: white;
        border: 1px solid #E8EAED;
        border-radius: 8px;
        padding: 8px;
        text-align: center;
        font-size: 11px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .nights-badge i {
        font-size: 16px;
        color: #FFB400;
    }

    .room-details {
        border-top: 1px solid #E8EAED;
        padding-top: 12px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: #3C3C3C;
        margin-bottom: 8px;
    }

    .detail-item i {
        font-size: 14px;
        color: #687176;
    }

    .detail-item a {
        font-size: 12px;
    }

    .info-note {
        background: #E3F2FD;
        padding: 12px;
        border-radius: 8px;
        display: flex;
        gap: 8px;
        align-items: start;
    }

    .price-section {
        border-top: 1px solid #E8EAED;
        padding-top: 16px;
    }

    .price-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
    }

    .price-header i {
        color: #0194F3;
        font-size: 18px;
    }

    .price-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 14px;
        color: #687176;
    }

    .price-row.total {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #E8EAED;
        font-weight: 600;
        color: #1C1C1C;
    }

    .price-row.total-amount {
        font-size: 13px;
    }

    .final-price {
        text-align: right;
        font-size: 24px;
        font-weight: 700;
        color: #FF6B35;
        margin-top: 8px;
    }

    .btn-continue {
        width: 100%;
        background: #0194F3;
        border: none;
        border-radius: 8px;
        padding: 14px;
        font-size: 16px;
        font-weight: 600;
        margin-top: 20px;
        transition: background 0.3s;
    }

    .btn-continue:hover {
        background: #0176C7;
    }

    .price-header .btn-collapse {
        border: none;
        background: transparent;
        padding: 4px;
        line-height: 1;
    }

    .price-header .btn-collapse:focus {
        outline: none;
        box-shadow: none;
    }

    .price-header .btn-collapse i {
        font-size: 18px;
        color: #0194F3;
    }

    @@media (min-width: 992px) {
        .sticky-top {
            position: sticky;
            z-index: 100;
        }
    }
</style>

<!-- Policy Modal -->
<div class="modal fade" id="policyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Lưu ý quan trọng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="list-group list-group-flush">
                    <div class="list-group-item py-3">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-cup-hot text-warning me-3" style="font-size:20px"></i>
                            <div>
                                <div class="fw-bold mb-1">Bữa sáng</div>
                                <div class="text-muted">Bữa sáng tại cơ sở lưu trú được phục vụ từ 06:30 đến 09:30.
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="list-group-item py-3">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-slash-circle text-danger me-3" style="font-size:20px"></i>
                            <div>
                                <div class="fw-bold mb-1">Hút Thuốc</div>
                                <div class="text-muted">Chỉ được phép hút thuốc trong khu vực chỉ định.</div>
                            </div>
                        </div>
                    </div>
                    <div class="list-group-item py-3">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-ban text-danger me-3" style="font-size:20px"></i>
                            <div>
                                <div class="fw-bold mb-1">Thú cưng</div>
                                <div class="text-muted">Không được mang theo thú cưng.</div>
                            </div>
                        </div>
                    </div>
                    <div class="list-group-item py-3">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-info-circle text-primary me-3" style="font-size:20px"></i>
                            <div>
                                <div class="fw-bold mb-1">Chính Sách Bổ Sung</div>
                                <div class="text-muted">
                                    TRẺ EM TỪ 0 ĐẾN DƯỚI 6 TUỔI ĐƯỢC Ở MIỄN PHÍ TRÊN GIƯỜNG CÓ SẴN VỚI BỐ MẸ.<br />
                                    TRẺ TỪ 6 TUỔI ĐẾN DƯỚI 11 TUỔI Ở CHUNG VỚI BỐ MẸ TRÊN GIƯỜNG CÓ SẴN VỚI PHỤ PHÍ
                                    150.000 VND.<br />
                                    TRẺ TỪ 11 TUỔI TRỞ LÊN ĐƯỢC CỘNG NHƯ NGƯỜI LỚN CÓ SET UP GIƯỜNG CÓ PHỤ VỚI PHÍ
                                    300.000 VND.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Disable validation for SpecialRequests field
        $(document).ready(function () {
            $('textarea[name="SpecialRequests"]').removeAttr('data-val-required');
            $('textarea[name="SpecialRequests"]').removeAttr('data-val');
        });
        document.getElementById('bookingForMyself').addEventListener('change', function () {
            const fullNameInput = document.querySelector('input[name="FullName"]');
            const guestNameInput = document.querySelector('input[name="GuestName"]');

            if (this.checked && fullNameInput.value) {
                guestNameInput.value = fullNameInput.value;
            } else if (!this.checked) {
                guestNameInput.value = '';
            }
        });

        // Discount Code Functionality
        @{
                var localizedStrings = new
                {
                            pleaseEnterDiscountCode = Localizer["PleaseEnterDiscountCode"].Value,
                            discountCodeApplied = Localizer["DiscountCodeApplied"].Value,
                            invalidDiscountCode = Localizer["InvalidDiscountCode"].Value,
                            apply = Localizer["Apply"].Value,
                            applied = Localizer["Applied"].Value
                };
            }
            const localizedStrings = @Html.Raw(JsonSerializer.Serialize(localizedStrings));

        let originalPrice = @((Model.PricePerNight * Model.TotalNights * 1.1m).ToString("F2").Replace(",", "."));
        let currentDiscount = 0;
        let appliedCode = '';
        const propertyId = @Model.PropertyId;

        document.getElementById('applyDiscount').addEventListener('click', async function () {
            console.log('Apply discount button clicked');
            const code = document.getElementById('discountCode').value.trim().toUpperCase();
            const messageDiv = document.getElementById('discountMessage');
            const discountRow = document.getElementById('discountRow');
            const discountAmount = document.getElementById('discountAmount');
            const finalPrice = document.getElementById('finalPrice');
            const applyButton = this;

            console.log('Code entered:', code);
            console.log('PropertyId:', propertyId);
            console.log('Original price:', originalPrice);

            if (!code) {
                messageDiv.innerHTML = '<span class="text-danger">' + localizedStrings.pleaseEnterDiscountCode + '</span>';
                return;
            }

            // Disable button while validating
            applyButton.disabled = true;
            applyButton.textContent = 'Đang kiểm tra...';

            try {
                console.log('Sending request to /Chat/ValidateDiscountCode with:', { code: code, propertyId: propertyId });
                
                const response = await fetch('/Chat/ValidateDiscountCode', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ code: code, propertyId: propertyId })
                });

                console.log('Response status:', response.status);
                const data = await response.json();
                console.log('Response data:', data);

                if (data.success && data.discount) {
                    const discount = data.discount;
                    let discountValue = 0;
                    let discountText = '';

                    // Calculate discount based on percent or amount
                    if (discount.discountPercent) {
                        discountValue = originalPrice * (discount.discountPercent / 100);
                        discountText = `Giảm ${discount.discountPercent}%`;
                    } else if (discount.discountAmount) {
                        discountValue = discount.discountAmount;
                        discountText = `Giảm ${parseInt(discount.discountAmount).toLocaleString('vi-VN')} VND`;
                    }

                    currentDiscount = discountValue;
                    appliedCode = code;

                    console.log('Discount applied:', discount);
                    console.log('Discount amount:', currentDiscount);

                    // Show discount row
                    discountRow.style.display = 'flex';
                    discountAmount.textContent = `-${Math.round(currentDiscount).toLocaleString('vi-VN')} VND`;

                    // Update final price
                    const newPrice = originalPrice - currentDiscount;
                    finalPrice.textContent = `${Math.round(newPrice).toLocaleString('vi-VN')} VND`;

                    console.log('New price:', newPrice);

                    // Show success message
                    messageDiv.innerHTML = `<span class="text-success">✓ ${discountText} đã được áp dụng!</span>`;

                    // Update button state
                    applyButton.textContent = localizedStrings.applied;
                    applyButton.classList.remove('btn-outline-primary');
                    applyButton.classList.add('btn-success');

                    // Update hidden fields for form submission
                    document.getElementById('discountCodeHidden').value = code;
                    document.getElementById('discountAmountHidden').value = currentDiscount;
                    document.getElementById('discountPercentageHidden').value = discount.discountPercent || 0;

                    // Update TotalPrice with discounted amount
                    document.querySelector('input[name="TotalPrice"]').value = newPrice;
                } else {
                    // Show error message
                    console.log('Discount validation failed:', data);
                    messageDiv.innerHTML = '<span class="text-danger">' + (data.message || localizedStrings.invalidDiscountCode) + '</span>';
                    
                    // Reset discount
                    currentDiscount = 0;
                    appliedCode = '';
                    discountRow.style.display = 'none';
                    finalPrice.textContent = `${Math.round(originalPrice).toLocaleString('vi-VN')} VND`;
                    
                    // Reset hidden fields
                    document.getElementById('discountCodeHidden').value = '';
                    document.getElementById('discountAmountHidden').value = '0';
                    document.getElementById('discountPercentageHidden').value = '0';
                    document.querySelector('input[name="TotalPrice"]').value = originalPrice;
                }
            } catch (error) {
                console.error('Error validating discount code:', error);
                console.error('Error details:', error.message, error.stack);
                messageDiv.innerHTML = '<span class="text-danger">Có lỗi xảy ra khi kiểm tra mã giảm giá. Vui lòng thử lại.</span>';
            } finally {
                applyButton.disabled = false;
                if (appliedCode !== code) {
                    applyButton.textContent = localizedStrings.apply;
                    applyButton.classList.remove('btn-success');
                    applyButton.classList.add('btn-outline-primary');
                }
            }
        });

        // Auto-uppercase discount code input and allow changing discount code
        document.getElementById('discountCode').addEventListener('input', function () {
            // Auto-uppercase
            this.value = this.value.toUpperCase();
            
            // Allow changing discount code
            if (appliedCode && this.value.toUpperCase() !== appliedCode) {
                // Reset discount
                currentDiscount = 0;
                appliedCode = '';

                document.getElementById('discountRow').style.display = 'none';
                document.getElementById('finalPrice').textContent = `${Math.round(originalPrice).toLocaleString()} VND`;
                document.getElementById('discountMessage').innerHTML = '';

                // Reset hidden fields
                document.getElementById('discountCodeHidden').value = '';
                document.getElementById('discountAmountHidden').value = '0';
                document.getElementById('discountPercentageHidden').value = '0';
                document.querySelector('input[name="TotalPrice"]').value = originalPrice;

                // Reset button to allow new application
                document.getElementById('applyDiscount').textContent = localizedStrings.apply;
                document.getElementById('applyDiscount').classList.remove('btn-success');
                document.getElementById('applyDiscount').classList.add('btn-outline-primary');
            }
        });

        // Allow clicking apply button again to change discount
        document.getElementById('applyDiscount').addEventListener('click', function () {
            // If already applied, allow changing
            if (this.textContent === localizedStrings.applied) {
                this.textContent = localizedStrings.apply;
                this.classList.remove('btn-success');
                this.classList.add('btn-outline-primary');

                // Clear current discount
                currentDiscount = 0;
                appliedCode = '';
                document.getElementById('discountRow').style.display = 'none';
                document.getElementById('finalPrice').textContent = `${Math.round(originalPrice).toLocaleString()} VND`;
                document.getElementById('discountMessage').innerHTML = '';

                // Re-apply the current code in the input by triggering click
                const currentCode = document.getElementById('discountCode').value.trim().toUpperCase();
                if (currentCode) {
                    // Trigger the apply button click to validate and apply the code
                    document.getElementById('applyDiscount').click();
                }
                return;
            }
        });

        document.querySelector('input[name="FullName"]').addEventListener('input', function () {
            const bookingForMyself = document.getElementById('bookingForMyself');
            const guestNameInput = document.querySelector('input[name="GuestName"]');

            if (bookingForMyself.checked) {
                guestNameInput.value = this.value;
            }
        });
    </script>
}