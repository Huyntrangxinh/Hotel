@model IEnumerable<HotelBooking.Models.Discount>
@{
    ViewData["Title"] = "Mã giảm giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger">@TempData["error"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Mã giảm giá</h2>
        <a asp-controller="Partner" asp-action="DiscountCreate" class="btn btn-primary">+ Tạo mã</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Bạn chưa có mã giảm giá nào. <a asp-controller="Partner" asp-action="DiscountCreate">Tạo mã giảm giá mới</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Tiêu đề</th>
                        <th>Giảm</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th class="text-center" style="width: 170px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td><code>@d.Code</code></td>
                            <td>@d.Title</td>
                            <td>
                                @if (d.DiscountPercent.HasValue)
                                {
                                    @($"{d.DiscountPercent}%")
                                }
                                else if (d.DiscountAmount.HasValue)
                                {
                                    @($"VND {d.DiscountAmount:N0}")
                                }
                            </td>
                            <td>@d.StartDate?.ToString("dd/MM/yyyy") - @d.EndDate?.ToString("dd/MM/yyyy")</td>
                            <td>@(d.IsActive ? "Hoạt động" : "Tắt")</td>
                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-controller="Partner"
                                       asp-action="DiscountEdit"
                                       asp-route-id="@d.Id">
                                        Sửa
                                    </a>
                                    <form asp-controller="Partner"
                                          asp-action="DiscountDelete"
                                          method="post"
                                          onsubmit="return confirm('Bạn chắc chắn muốn xóa mã @d.Code?');"
                                          style="display: inline;">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Xóa
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

