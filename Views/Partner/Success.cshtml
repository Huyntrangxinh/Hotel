@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = @Localizer["RegistrationSuccessful"];
}

<section class="py-5" style="background-color: #f8f9fa;">
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">

        <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border text-center" style="max-width: 550px; width: 100%;">

            <div class="mb-4">
                <i class="bi bi-calendar2-check-fill" style="font-size: 80px; color: #0d6efd;"></i>
            </div>

            <h3 class="fw-bold mb-3">@Localizer["RegistrationSubmitted"]</h3>

            <p class="text-muted">
                @Localizer["RegistrationSubmittedMessage"]
            </p>
            <p class="text-muted small">
                @Localizer["RegistrationWaitMessage"]
            </p>

            <div class="d-grid gap-2 mt-4">
                @if (ViewBag.LatestPropertyId != null)
                {
                    <a asp-action="PropertyDetail" asp-route-id="@ViewBag.LatestPropertyId"
                        class="btn btn-primary btn-lg">@Localizer["ViewPropertyInformation"]</a>
                }
                else
                {
                    <a asp-action="MyProperties" class="btn btn-primary btn-lg">@Localizer["ViewPropertyInformation"]</a>
                }
                <a asp-controller="Home" asp-action="Index"
                    class="btn btn-outline-secondary">@Localizer["BackToHomePage"]</a>
            </div>
        </div>
    </div>
</section>