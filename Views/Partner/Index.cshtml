@inject IStringLocalizer<HotelBooking.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["ListYourProperty"];
}

<section class="partner-hero py-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <!-- Trái: headline -->
            <div class="col-lg-7 text-white">
                <h1 class="display-4 fw-bold lh-tight">
                    @Localizer["ListYourPropertyTitle"]
                </h1>
                <p class="lead text-white-50 mt-3">
                    @Localizer["ListYourPropertySubtitle"]
                </p>
            </div>

            <!-- Phải: thẻ CTA -->
            <div class="col-lg-5">
                <div class="cta-card bg-white p-4 rounded-4">
                    <h4 class="fw-bold mb-3">@Localizer["FreeRegistration"]</h4>
                    <ul class="list-unstyled small mb-4">
                        <li class="d-flex mb-2"><span class="check-badge me-2">✓</span>@Localizer["HostBenefit1"]</li>
                        <li class="d-flex mb-2"><span class="check-badge me-2">✓</span>@Localizer["HostBenefit2"]</li>
                        <li class="d-flex"><span class="check-badge me-2">✓</span>@Localizer["HostBenefit3"]</li>
                    </ul>
                    <a asp-controller="Partner" asp-action="RegisterNewProperty"
                        class="btn btn-bk-primary w-100 mb-2">@Localizer["StartNow"]</a>
                    <div class="small text-muted">
                        @Localizer["AlreadyStarted"]
                        <a asp-controller="Partner" asp-action="MyProperties"
                            class="link-primary">@Localizer["Continue"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container">
        <h2 class="fw-bold mb-4">@Localizer["HostSupportTitle"]</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <h5 class="fw-bold">@Localizer["CustomizeRules"]</h5>
                <ul class="list-unstyled small text-muted">
                    <li class="d-flex mb-2"><i class="bi bi-check2-circle me-2"></i>@Localizer["AcceptRejectBooking"]
                    </li>
                    <li class="d-flex mb-2"><i class="bi bi-check2-circle me-2"></i>@Localizer["ManageExpectations"]
                    </li>
                </ul>
            </div>
            <div class="col-md-4">
                <h5 class="fw-bold">@Localizer["KnowMoreAboutGuests"]</h5>
                <ul class="list-unstyled small text-muted">
                    <li class="d-flex mb-2"><i class="bi bi-check2-circle me-2"></i>@Localizer["ChatBeforeAccepting"]
                    </li>
                    <li class="d-flex mb-2"><i class="bi bi-check2-circle me-2"></i>@Localizer["ViewTravelHistory"]</li>
                </ul>
            </div>
            <div class="col-md-4">
                <h5 class="fw-bold">@Localizer["Protected"]</h5>
                <ul class="list-unstyled small text-muted">
                    <li class="d-flex mb-2"><i
                            class="bi bi-check2-circle me-2"></i>@Localizer["ProtectionAgainstClaims"]</li>
                    <li class="d-flex mb-2"><i
                            class="bi bi-check2-circle me-2"></i>@Localizer["DamageProtectionOptions"]</li>
                </ul>
            </div>
        </div>
    </div>
</section>
<section class="section-muted py-5">

    <div class="container">
        <h2 class="fw-bold mb-4">@Localizer["FinancialControlTitle"]</h2>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <h5 class="fw-bold"><i class="bi bi-credit-card me-2 text-success"></i>@Localizer["EasyPayment"]</h5>
                <p class="text-muted small mb-0">
                    @Localizer["EasyPaymentDesc"]
                </p>
            </div>
            <div class="col-md-6 col-lg-4">
                <h5 class="fw-bold"><i class="bi bi-calendar2-check me-2 text-success"></i>@Localizer["DailyPayment"]
                </h5>
                <p class="text-muted small mb-0">
                    @Localizer["DailyPaymentDesc"]
                </p>
            </div>
            <div class="col-md-6 col-lg-4">
                <h5 class="fw-bold"><i
                        class="bi bi-graph-up-arrow me-2 text-success"></i>@Localizer["MultipleAccommodations"]</h5>
                <p class="text-muted small mb-0">
                    @Localizer["MultipleAccommodationsDesc"]
                </p>
            </div>
            <div class="col-md-6 col-lg-4">
                <h5 class="fw-bold"><i class="bi bi-shield-check me-2 text-success"></i>@Localizer["MinimizeRisk"]</h5>
                <p class="text-muted small mb-0">
                    @Localizer["MinimizeRiskDesc"]
                </p>
            </div>
            <div class="col-md-6 col-lg-4">
                <h5 class="fw-bold"><i class="bi bi-cash-coin me-2 text-success"></i>@Localizer["BetterCashFlow"]</h5>
                <p class="text-muted small mb-0">
                    @Localizer["BetterCashFlowDesc"]
                </p>
            </div>
        </div>

        <a asp-controller="Partner" asp-action="RegisterNewProperty"
            class="btn btn-bk-outline btn-bk-pill mt-4">@Localizer["EarnMoreToday"]</a>



    </div>
</section>
<section class="py-5 bg-white">
    <div class="container">
        <h2 class="fw-bold mb-4">@Localizer["EasyStartTitle"]</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="step-card p-4 h-100">
                    <div class="step-icon"><i class="bi bi-house-add"></i></div>
                    <h5 class="fw-bold mt-3">@Localizer["EnterPropertyInfo"]</h5>
                    <p class="text-muted small mb-0">
                        @Localizer["EnterPropertyInfoDesc"]
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card p-4 h-100">
                    <div class="step-icon"><i class="bi bi-rocket-takeoff"></i></div>
                    <h5 class="fw-bold mt-3">@Localizer["StartReceivingBookings"]</h5>
                    <p class="text-muted small mb-0">
                        @Localizer["StartReceivingBookingsDesc"]
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card p-4 h-100">
                    <div class="step-icon"><i class="bi bi-binoculars"></i></div>
                    <h5 class="fw-bold mt-3">@Localizer["StandOutMarket"]</h5>
                    <p class="text-muted small mb-0">
                        @Localizer["StandOutMarketDesc"]
                    </p>
                </div>
            </div>
        </div>


        <a asp-controller="Partner" asp-action="RegisterNewProperty"
            class="btn btn-bk-primary btn-bk-pill btn-bk-lg mt-4">@Localizer["StartToday"]</a>

    </div>


</section>
<section class="py-5 section-muted">
    <div class="container">
        <h2 class="fw-bold mb-4">@Localizer["GlobalReachTitle"]</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="metric">
                    <div class="metric-value">@Localizer["GlobalReachMetric1"]</div>
                    <div class="metric-note">@Localizer["GlobalReachMetric1Desc"]</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="metric">
                    <div class="metric-value">@Localizer["GlobalReachMetric2"]</div>
                    <div class="metric-note">@Localizer["GlobalReachMetric2Desc"]</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="metric">
                    <div class="metric-value">@Localizer["GlobalReachMetric3"]</div>
                    <div class="metric-note">@Localizer["GlobalReachMetric3Desc"]</div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="section-muted py-5" id="testimonials">
    <div class="container">
        <h2 class="fw-bold mb-4">@Localizer["HostTestimonialsTitle"]</h2>

        <div class="row g-4">
            <!-- Card 1 -->
            <div class="col-md-6 col-lg-4">
                <figure class="testimonial-card p-3 h-100">
                    <blockquote class="mb-3">
                        “Tôi đã có dịp đón trong vòng 15 phút và không phải trả phí sau đó đối với đặt phòng đầu tiên!”
                    </blockquote>
                    <figcaption class="d-flex align-items-center gap-2">
                        <img class="host-avatar" src="https://i.pravatar.cc/80?img=12" alt="">
                        <div>
                            <div class="fw-semibold small">Patley Rose</div>
                            <div class="text-muted xsmall">Host ở Vũng Ánh</div>
                        </div>
                    </figcaption>
                </figure>
            </div>

            <!-- Card 2 -->
            <div class="col-md-6 col-lg-4">
                <figure class="testimonial-card p-3 h-100">
                    <blockquote class="mb-3">
                        “Booking.com là lựa chọn số 1, và điều này sinh lợi cho chúng tôi. Mạng lưới đa dạng
                        đã giúp chỗ nghỉ của tôi thu hút đúng nhóm khách, nhờ vậy nhận đặt phòng nhanh hơn.”
                    </blockquote>
                    <figcaption class="d-flex align-items-center gap-2">
                        <img class="host-avatar" src="https://i.pravatar.cc/80?img=25" alt="">
                        <div>
                            <div class="fw-semibold small">Martin Fieldman</div>
                            <div class="text-muted xsmall">Chủ Airbnb, Amsterdam</div>
                        </div>
                    </figcaption>
                </figure>
            </div>

            <!-- Card 3 -->
            <div class="col-md-6 col-lg-4">
                <figure class="testimonial-card p-3 h-100">
                    <blockquote class="mb-3">
                        “Booking.com chiếm lượng lớn lưu trú nhất trong số các kênh phân phối và đã giúp chúng
                        tôi lấp đặt nhiều đêm hơn mỗi mùa.”
                    </blockquote>
                    <figcaption class="d-flex align-items-center gap-2">
                        <img class="host-avatar" src="https://i.pravatar.cc/80?img=7" alt="">
                        <div>
                            <div class="fw-semibold small">Michel vd. Aija</div>
                            <div class="text-muted xsmall">Nhà nghỉ Maison de Soufley</div>
                        </div>
                    </figcaption>
                </figure>
            </div>

            <!-- Card 4 -->
            <div class="col-md-6 col-lg-4">
                <figure class="testimonial-card p-3 h-100">
                    <blockquote class="mb-3">
                        “Du khách đến Charming Loft’s của tôi đều nói họ tìm thấy chỗ ở qua Booking.com rất dễ
                        dàng, còn tôi thì quản lý cực đơn giản trong ứng dụng. Đội hỗ trợ cũng rất tuyệt.”
                    </blockquote>
                    <figcaption class="d-flex align-items-center gap-2">
                        <img class="host-avatar" src="https://i.pravatar.cc/80?img=31" alt="">
                        <div>
                            <div class="fw-semibold small">Louis Gonzalez</div>
                            <div class="text-muted xsmall">Charming Loft, Los Angeles</div>
                        </div>
                    </figcaption>
                </figure>
            </div>

            <!-- Card 5 -->
            <div class="col-md-6 col-lg-4">
                <figure class="testimonial-card p-3 h-100">
                    <blockquote class="mb-3">
                        “Sau khi hợp tác chủ yếu với Booking.com, tỷ lệ lấp phòng và doanh thu ở chỗ nghỉ nhỏ
                        của tôi đã tăng rõ rệt.”
                    </blockquote>
                    <figcaption class="d-flex align-items-center gap-2">
                        <img class="host-avatar" src="https://i.pravatar.cc/80?img=36" alt="">
                        <div>
                            <div class="fw-semibold small">Zoey Berghoff</div>
                            <div class="text-muted xsmall">Host ở Hội An</div>
                        </div>
                    </figcaption>
                </figure>
            </div>

            <!-- Card 6 -->
            <div class="col-md-6 col-lg-4">
                <figure class="testimonial-card p-3 h-100">
                    <blockquote class="mb-3">
                        “Qua tám năm đi cùng Booking.com với cùng dàn nhân sự, chúng tôi tối ưu chi phí và
                        thời gian.”
                    </blockquote>
                    <figcaption class="d-flex align-items-center gap-2">
                        <img class="host-avatar" src="https://i.pravatar.cc/80?img=58" alt="">
                        <div>
                            <div class="fw-semibold small">Shawn Ritzenthaler</div>
                            <div class="text-muted xsmall">NX Hills Mansion</div>
                        </div>
                    </figcaption>
                </figure>
            </div>
        </div>

        <div class="text-center mt-3">
            <a asp-controller="Partner" asp-action="RegisterNewProperty"
                class="btn btn-accent rounded-pill px-4">@Localizer["JoinHostsLikeYou"]</a>
        </div>
    </div>
</section>
