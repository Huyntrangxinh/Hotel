@{
    ViewData["Title"] = "Tất cả đặt phòng";
    var property = ViewBag.Property as dynamic;
    var bookings = ViewBag.Bookings as List<dynamic>;
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Tất cả đặt phòng</h2>
            <p class="text-muted mb-0">@property?.Name</p>
        </div>
        <a href="@Url.Action("PropertyHub", "Partner", new { propertyId = property?.Id })"
            class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle"></i> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bookings List -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Danh sách đặt phòng (@bookings?.Count booking)</h5>
        </div>
        <div class="card-body p-0">
            @if (bookings != null && bookings.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đặt phòng</th>
                                <th>Phòng</th>
                                <th>Khách hàng</th>
                                <th>Ngày nhận phòng</th>
                                <th>Ngày trả phòng</th>
                                <th>Số đêm</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in bookings)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-primary">@item.Booking.BookingCode</span>
                                    </td>
                                    <td>@item.RoomName</td>
                                    <td>
                                        <div>
                                            <div class="fw-bold">@item.Booking.FullName</div>
                                            <small class="text-muted">@item.Booking.Email</small>
                                        </div>
                                    </td>
                                    <td>@item.Booking.CheckIn.ToString("dd/MM/yyyy")</td>
                                    <td>@item.Booking.CheckOut.ToString("dd/MM/yyyy")</td>
                                    <td>@item.Booking.TotalNights</td>
                                    <td>
                                        <span class="fw-bold">@item.Booking.TotalPrice.ToString("N0") VND</span>
                                    </td>
                                    <td>
                                        @{
                                            var statusClass = item.Booking.Status switch
                                            {
                                                "Pending" => "warning",
                                                "Confirmed" => "success",
                                                "Cancelled" => "danger",
                                                "Completed" => "info",
                                                _ => "secondary"
                                            };
                                            var statusText = item.Booking.Status switch
                                            {
                                                "Pending" => "Chờ xác nhận",
                                                "Confirmed" => "Đã xác nhận",
                                                "Cancelled" => "Đã hủy",
                                                "Completed" => "Hoàn thành",
                                                _ => item.Booking.Status
                                            };
                                        }
                                        <span class="badge bg-@statusClass">@statusText</span>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("BookingDetails", "Partner", new { bookingCode = item.Booking.BookingCode })"
                                            class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x display-1 text-muted"></i>
                    <h5 class="mt-3">Chưa có đặt phòng nào</h5>
                    <p class="text-muted">Khách hàng chưa đặt phòng cho chỗ nghỉ này.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table th {
        border-top: none;
        font-weight: 600;
        color: #495057;
    }

    .table td {
        vertical-align: middle;
    }

    .badge {
        font-size: 0.75em;
    }
</style>
