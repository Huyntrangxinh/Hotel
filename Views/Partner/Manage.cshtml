@model IEnumerable<HotelBooking.Models.Property>
@inject IStringLocalizer<HotelBooking.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["ManageProperties"];
    var stats = ViewBag.Stats;
}

<div class="container-fluid py-3">
    <div class="row g-3">
        <div class="col-lg-3">
            <div class="list-group small">
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center active">
                    @Localizer["Overview"]
                    <span class="badge bg-light text-dark">@stats.Total</span>
                </a>
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="@Url.Action("MyProperties","Partner")">
                    @Localizer["YourProperties"]
                </a>
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="@Url.Action("RegisterNewProperty","Partner")">
                    @Localizer["NewRegistration"]
                </a>
            </div>

            <div class="card mt-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between small"><span>@Localizer["Draft"]</span><strong>@stats.Draft</strong></div>
                    <div class="d-flex justify-content-between small"><span>@Localizer["Submitted"]</span><strong>@stats.Submitted</strong></div>
                    <div class="d-flex justify-content-between small"><span>@Localizer["Approved"]</span><strong>@stats.Approved</strong></div>
                </div>
            </div>
        </div>
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0 fw-bold">@Localizer["ManageProperties"]</h5>
                <a href="@Url.Action("RegisterNewProperty","Partner")" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i> @Localizer["NewRegistration"]</a>
            </div>

            <div class="row g-2">
                @foreach (var p in Model)
                {
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <div class="fw-semibold">@p.Name</div>
                                        <div class="text-muted small">@((string.IsNullOrEmpty(p.AddressLine)?Localizer["NoAddress"]:p.AddressLine))</div>
                                    </div>
                                    
                                </div>
                                <div class="mt-2 d-flex gap-2">
                                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("PropertyDetail","Partner", new { id = p.Id })">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="btn btn-outline-primary btn-sm" href="@Url.Action("PropertyData","Partner", new { propertyId = p.Id, tab = "property" })">Thiết lập</a>
                                    <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Calendar","Partner", new { propertyId = p.Id })">Lịch giá</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


