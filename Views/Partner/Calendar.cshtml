@model List<HotelBooking.Models.Room>
@using HotelBooking.ViewModels
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Calendar - Booking Management";
    var propertyId = (int)ViewBag.PropertyId;
    var startDate = (DateTime)ViewBag.StartDate;
    var endDate = (DateTime)ViewBag.EndDate;
    var propertyName = (string?)ViewBag.PropertyName ?? "";
    var roomsByType = (List<IGrouping<string, HotelBooking.Models.Room>>)ViewBag.RoomsByType;
    var bookings = (List<HotelBooking.Models.Booking>)ViewBag.Bookings;
    var availabilityMap = (Dictionary<string, Dictionary<DateTime, (int Available, int Total)>>)ViewBag.AvailabilityMap;

    var days = new List<DateTime>();
    for (var d = startDate; d < endDate; d = d.AddDays(1))
    {
        days.Add(d);
    }

    var weekdays = new[] { "CN", "T2", "T3", "T4", "T5", "T6", "T7" };
    var bookingColors = new[] { "#60A5FA", "#34D399", "#F472B6", "#FBBF24", "#94A3B8" };
    var roomRateOptions = ViewBag.RoomRateOptions as Dictionary<int, List<CalendarRoomRateOption>> ?? new();
    var rateOverridesRaw = ViewBag.RateOverrides;
    var rateOverrides = rateOverridesRaw != null ? 
        ((Dictionary<(int RoomId, int? RoomPriceId), Dictionary<DateTime, decimal>>)rateOverridesRaw) : 
        new Dictionary<(int, int?), Dictionary<DateTime, decimal>>();
    var antiForgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    
    // Determine current year and month from startDate
    var currentYear = startDate.Year;
    var currentMonth = startDate.Month;
}

<input type="hidden" id="calendar-property-id" value="@propertyId" />
<input type="hidden" id="calendar-antiforgery" value="@antiForgeryToken" />

<div class="booking-calendar-container">
    <div class="calendar-content">
        <div class="calendar-period-nav">
            <div class="year-scroll">
                @for (int year = DateTime.UtcNow.Year - 3; year <= DateTime.UtcNow.Year + 3; year++)
                {
                    <button class="year-pill @(year == currentYear ? "active" : "")" data-year="@year">@year</button>
                }
            </div>
            <div class="month-tabs">
                @for (int month = 1; month <= 12; month++)
                {
                    var isActive = month == currentMonth;
                    <button class="month-pill @(isActive ? "active" : "")" data-month="@month">
                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                    </button>
                }
            </div>
        </div>

        <div class="calendar-grid-wrapper">
            <div class="calendar-grid">
                <div class="grid-header">
                    <div class="room-header-cell">Rooms</div>
                    @foreach (var day in days)
                    {
                        var weekday = weekdays[(int)day.DayOfWeek];
                        var isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;
                        <div class="date-header-cell @(isWeekend ? "weekend" : "")">
                            <div class="weekday">@weekday</div>
                            <div class="date">@day.ToString("MM/dd")</div>
                        </div>
                    }
                </div>

                @if (roomsByType != null)
                {
                    foreach (var roomTypeGroup in roomsByType)
                    {
                        var roomType = roomTypeGroup.Key;
                        var typeRooms = roomTypeGroup.ToList();

                        <div class="grid-row room-type-availability-row">
                            <div class="room-cell room-type-cell">@roomType</div>
                            @foreach (var day in days)
                            {
                                var available = 0;
                                var total = 0;
                                if (availabilityMap != null && availabilityMap.ContainsKey(roomType) &&
                                availabilityMap[roomType].ContainsKey(day))
                                {
                                    available = availabilityMap[roomType][day].Available;
                                    total = availabilityMap[roomType][day].Total;
                                }
                                var typeSafeAvailable = available < 0 ? 0 : available;
                                <div class="day-cell availability-cell">
                                    <span class="availability-text">@typeSafeAvailable/@total</span>
                                </div>
                            }
                        </div>

                        foreach (var room in typeRooms)
                        {
                            var roomBookings = bookings?.Where(b => b.RoomId == room.Id).ToList() ?? new
                            List<HotelBooking.Models.Booking>();
                            <div class="grid-row room-row" data-room-id="@room.Id">
                                <div class="room-cell room-name-cell">
                                    <div class="room-number">@room.Name</div>
                                    <div
                                        class="room-status-dot @(roomBookings.Any(b => b.CheckIn <= DateTime.Today && b.CheckOut > DateTime.Today) ? "occupied" : "available")">
                                    </div>
                                </div>
                                @foreach (var day in days)
                                {
                                    var dayBookings = roomBookings
                                        .Where(b => b.CheckIn <= day && b.CheckOut > day)
                                        .ToList();
                                    var cellHeight = 52 + Math.Max(0, (dayBookings.Count - 1) * 46);
                                    <div class="day-cell booking-cell" style="min-height:52px;">
                                        @if (dayBookings.Any())
                                        {
                                            <button type="button" 
                                                    class="booking-list-btn" 
                                                    data-room-id="@room.Id"
                                                    data-room-name="@room.Name"
                                                    data-date="@day.ToString("yyyy-MM-dd")"
                                                    data-display-date="@day.ToString("dd/MM/yyyy")"
                                                    data-booking-count="@dayBookings.Count">
                                                <i class="bi bi-list-ul"></i>
                                                <span>Danh sách đặt phòng (@dayBookings.Count)</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            if (roomRateOptions.TryGetValue(room.Id, out var rateOptions) && rateOptions.Any())
                            {
                                foreach (var rate in rateOptions)
                                {
                                    <div class="grid-row room-rate-row">
                                        <div class="room-cell room-rate-cell">
                                            <div class="rate-name">@rate.OptionName</div>
                                            <div class="rate-meta">
                                                @(rate.PolicyDisplayName ?? "Gói giá")
                                                @if (rate.BreakfastIncluded.HasValue)
                                                {
                                                    <span>• @(rate.BreakfastIncluded.Value ? "Có bữa sáng" : "Không bữa sáng")</span>
                                                }
                                            </div>
                                            <button type="button"
                                                    class="rate-range-btn"
                                                    data-room-id="@room.Id"
                                                    data-room-name="@room.Name"
                                                    data-current-price="@rate.Amount"
                                                    data-room-price-id="@rate.RoomPriceId"
                                                    data-rate-label="@rate.OptionName">
                                                Điều chỉnh giá phòng
                                            </button>
                                        </div>
                                        @foreach (var day in days)
                                        {
                                            var displayPrice = rate.Amount;
                                            var overrideKey = (room.Id, rate.RoomPriceId);
                                            if (rateOverrides.TryGetValue(overrideKey, out var overridesForRoom) &&
                                                overridesForRoom.TryGetValue(day.Date, out var overridePrice))
                                            {
                                                displayPrice = overridePrice;
                                            }
                                            var dayBookingCountForPrice = roomBookings
                                                .Count(b => b.CheckIn <= day && b.CheckOut > day);
                                            var remainingForDay = Math.Max(0, room.Quantity - dayBookingCountForPrice);
                                            var isSoldOutForDay = remainingForDay <= 0;
                                            <div class="day-cell rate-price-cell">
                                                <div class="rate-price-wrapper">
                                                    @if (isSoldOutForDay)
                                                    {
                                                        <span class="rate-price sold-out-text">Đã hết phòng</span>
                                                    }
                                                    else
                                                    {
                                                    <span class="rate-price">@displayPrice.ToString("N0") @rate.Currency</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }
                    }
                }
            </div>
        </div>

        <div class="calendar-legend">
            <span><span class="legend-dot new"></span>New</span>
            <span><span class="legend-dot confirmed"></span>Confirmed</span>
            <span><span class="legend-dot due-in"></span>Due in</span>
            <span><span class="legend-dot checked-in"></span>Checked in</span>
            <span><span class="legend-dot due-out"></span>Due out</span>
            <span><span class="legend-dot checked-out"></span>Checked out</span>
            <span><span class="legend-dot booking-offer"></span>Booking offer</span>
            <span><span class="legend-dot out-of-order"></span>Out of order</span>
        </div>
    </div>
</div>

<div id="rate-range-overlay" class="rate-edit-overlay" aria-hidden="true">
    <div class="rate-edit-modal" role="dialog" aria-modal="true">
        <div class="rate-modal-header">
            <h5>Tăng/giảm giá theo khoảng ngày</h5>
            <button type="button" id="rate-range-close" class="btn-close" aria-label="Đóng"></button>
        </div>
        <form id="rate-range-form">
            <div class="modal-field">
                <label>Phòng & gói</label>
                <div id="rate-range-room" class="modal-value">—</div>
            </div>
            <div class="modal-field">
                <label>Giá cũ (VND)</label>
                <input type="text" id="rate-range-old-price" class="form-control" readonly style="background-color: #f5f5f5; cursor: not-allowed;" />
            </div>
            <div class="modal-field">
                <label>Giá mới (VND)</label>
                <input type="text" id="rate-range-price" class="form-control" required placeholder="24.000.000" />
            </div>
            <div class="modal-field">
                <label>Ngày bắt đầu áp dụng</label>
                <input type="date" id="rate-range-start" class="form-control" required />
            </div>
            <div class="modal-field">
                <label>Ngày kết thúc áp dụng</label>
                <input type="date" id="rate-range-end" class="form-control" required />
            </div>
            <div class="modal-field">
                <label>Mô tả</label>
                <textarea id="rate-range-note" class="form-control modal-textarea" rows="3" placeholder="Ví dụ: Giá cuối tuần, lễ Tết ..."></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="rate-range-cancel">Hủy</button>
                <button type="submit" class="btn btn-primary btn-sm">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

<div id="booking-list-overlay" class="rate-edit-overlay" aria-hidden="true">
    <div class="rate-edit-modal" role="dialog" aria-modal="true" style="max-width: 1200px; width: 90%; max-height: 90vh; overflow-y: auto;">
        <div class="rate-modal-header">
            <h5 id="booking-list-title">Danh sách đặt phòng</h5>
            <button type="button" id="booking-list-close" class="btn-close" aria-label="Đóng"></button>
        </div>
        <div id="booking-list-content" style="padding: 16px;">
            <div style="text-align: center; padding: 20px;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.booking-info-btn').forEach(btn => {
            btn.addEventListener('click', function (event) {
                event.stopPropagation();
            });
        });

        const propertyId = document.getElementById('calendar-property-id')?.value;
        const antiForgery = document.getElementById('calendar-antiforgery')?.value;

        // Handle year and month selection
        let selectedYear = @currentYear;
        let selectedMonth = @currentMonth;

        document.querySelectorAll('.year-pill').forEach(pill => {
            pill.addEventListener('click', function() {
                selectedYear = parseInt(this.dataset.year);
                updateCalendar();
            });
        });

        document.querySelectorAll('.month-pill').forEach(pill => {
            pill.addEventListener('click', function() {
                selectedMonth = parseInt(this.dataset.month);
                updateCalendar();
            });
        });

        function updateCalendar() {
            // Update active states
            document.querySelectorAll('.year-pill').forEach(pill => {
                if (parseInt(pill.dataset.year) === selectedYear) {
                    pill.classList.add('active');
                } else {
                    pill.classList.remove('active');
                }
            });

            document.querySelectorAll('.month-pill').forEach(pill => {
                if (parseInt(pill.dataset.month) === selectedMonth) {
                    pill.classList.add('active');
                } else {
                    pill.classList.remove('active');
                }
            });

            // Reload calendar with selected month
            const url = `/Partner/Calendar?propertyId=${propertyId}&year=${selectedYear}&month=${selectedMonth}`;
            window.location.href = url;
        }
        const rateRangeOverlay = document.getElementById('rate-range-overlay');
        const rateRangeClose = document.getElementById('rate-range-close');
        const rateRangeCancel = document.getElementById('rate-range-cancel');
        const rateRangeForm = document.getElementById('rate-range-form');
        const rateRangeRoom = document.getElementById('rate-range-room');
        const rateRangeOldPrice = document.getElementById('rate-range-old-price');
        const rateRangePrice = document.getElementById('rate-range-price');
        const rateRangeStart = document.getElementById('rate-range-start');
        const rateRangeEnd = document.getElementById('rate-range-end');
        const rateRangeNote = document.getElementById('rate-range-note');
        let currentRangeData = null;

        function formatNumber(num) {
            if (!num && num !== 0) return '';
            const numStr = num.toString().replace(/\./g, '');
            return numStr.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        }

        function parseFormattedNumber(str) {
            if (!str) return 0;
            return parseFloat(str.replace(/\./g, '')) || 0;
        }

        function openRangeModal(data) {
            currentRangeData = data;
            rateRangeRoom.textContent = `${data.roomName} • ${data.rateLabel}`;
            const oldPrice = parseFloat(data.currentPrice || 0);
            rateRangeOldPrice.value = formatNumber(oldPrice);
            rateRangePrice.value = '';
            rateRangeStart.value = '';
            rateRangeEnd.value = '';
            rateRangeNote.value = '';
            rateRangeOverlay.classList.add('show');
            rateRangeOverlay.setAttribute('aria-hidden', 'false');
            rateRangePrice.focus();
        }

        function closeRangeModal() {
            rateRangeOverlay.classList.remove('show');
            rateRangeOverlay.setAttribute('aria-hidden', 'true');
            currentRangeData = null;
        }

        rateRangeClose?.addEventListener('click', closeRangeModal);
        rateRangeCancel?.addEventListener('click', closeRangeModal);
        rateRangeOverlay?.addEventListener('click', function (event) {
            if (event.target === rateRangeOverlay) {
                closeRangeModal();
            }
        });

        document.querySelectorAll('.rate-range-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const dataset = this.dataset;
                openRangeModal({
                    roomId: dataset.roomId,
                    roomPriceId: dataset.roomPriceId,
                    roomName: dataset.roomName,
                    rateLabel: dataset.rateLabel,
                    currentPrice: dataset.currentPrice
                });
            });
        });

        rateRangePrice?.addEventListener('input', function (e) {
            let value = e.target.value.replace(/\./g, '');
            if (value && !isNaN(value)) {
                e.target.value = formatNumber(value);
            }
        });

        rateRangeForm?.addEventListener('submit', async function (event) {
            event.preventDefault();
            if (!currentRangeData) return;

            const amount = parseFormattedNumber(rateRangePrice.value);
            const startDate = rateRangeStart.value;
            const endDate = rateRangeEnd.value;

            if (isNaN(amount) || amount <= 0) {
                alert('Vui lòng nhập giá hợp lệ.');
                return;
            }

            if (!startDate || !endDate || new Date(startDate) > new Date(endDate)) {
                alert('Ngày kết thúc phải sau ngày bắt đầu.');
                return;
            }

            try {
                const response = await fetch('/Partner/ApplyRateAdjustment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgery || ''
                    },
                    body: JSON.stringify({
                        propertyId: parseInt(propertyId || '0'),
                        roomId: parseInt(currentRangeData.roomId),
                        roomPriceId: parseInt(currentRangeData.roomPriceId),
                        amount,
                        startDate,
                        endDate,
                        description: rateRangeNote.value?.trim()
                    })
                });

                if (!response.ok) {
                    throw new Error('Không thể lưu điều chỉnh giá.');
                }

                closeRangeModal();
                window.location.reload();
            } catch (error) {
                console.error(error);
                alert('Có lỗi xảy ra khi lưu điều chỉnh giá. Vui lòng thử lại.');
            }
        });

        // Booking list modal
        const bookingListOverlay = document.getElementById('booking-list-overlay');
        const bookingListClose = document.getElementById('booking-list-close');
        const bookingListTitle = document.getElementById('booking-list-title');
        const bookingListContent = document.getElementById('booking-list-content');

        function openBookingListModal(data) {
            bookingListTitle.textContent = `Danh sách đặt phòng - ${data.roomName} - ${data.displayDate}`;
            bookingListContent.innerHTML = '<div style="text-align: center; padding: 20px;"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>';
            bookingListOverlay.classList.add('show');
            bookingListOverlay.setAttribute('aria-hidden', 'false');

            // Load booking list
            fetch(`/Partner/GetBookingsForDate?propertyId=${propertyId}&roomId=${data.roomId}&date=${data.date}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.bookings) {
                        renderBookingList(data.bookings);
                    } else {
                        bookingListContent.innerHTML = '<div style="padding: 20px; text-align: center; color: #64748b;">Không có đặt phòng nào.</div>';
                    }
                })
                .catch(error => {
                    console.error(error);
                    bookingListContent.innerHTML = '<div style="padding: 20px; text-align: center; color: #ef4444;">Có lỗi xảy ra khi tải danh sách đặt phòng.</div>';
                });
        }

        function renderBookingList(bookings) {
            if (!bookings || bookings.length === 0) {
                bookingListContent.innerHTML = '<div style="padding: 20px; text-align: center; color: #64748b;">Không có đặt phòng nào.</div>';
                return;
            }

            let html = '<div style="display: flex; flex-direction: column; gap: 12px;">';
            bookings.forEach(booking => {
                const checkIn = new Date(booking.checkIn).toLocaleDateString('vi-VN');
                const checkOut = new Date(booking.checkOut).toLocaleDateString('vi-VN');
                html += `
                    <div style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; background: #fff;">
                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px;">
                            <div>
                                <h6 style="margin: 0; font-weight: 600; color: #0f172a;">${escapeHtml(booking.guestName)}</h6>
                                <div style="font-size: 12px; color: #64748b; margin-top: 4px;">
                                    ${checkIn} - ${checkOut}
                                </div>
                            </div>
                            <a href="/Partner/BookingDetails?bookingCode=${booking.bookingCode}" 
                               class="btn btn-sm btn-outline-primary" 
                               style="text-decoration: none;">
                                <i class="bi bi-info-circle"></i> Chi tiết
                            </a>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px;">
                            <div><strong>Người liên hệ:</strong> ${escapeHtml(booking.contactName || '—')}</div>
                            <div><strong>Số điện thoại:</strong> ${escapeHtml(booking.phoneNumber || '—')}</div>
                            <div><strong>Email:</strong> ${escapeHtml(booking.email || '—')}</div>
                            <div><strong>Số khách:</strong> ${booking.guests || '—'}</div>
                            <div><strong>Tổng giá:</strong> ${formatPrice(booking.totalPrice)}</div>
                            <div><strong>Trạng thái:</strong> <span class="badge bg-${getStatusColor(booking.status)}">${escapeHtml(booking.status)}</span></div>
                        </div>
                        ${booking.specialRequests ? `<div style="margin-top: 12px; padding: 8px; background: #f8fafc; border-radius: 6px; font-size: 12px;"><strong>Yêu cầu đặc biệt:</strong> ${escapeHtml(booking.specialRequests)}</div>` : ''}
                    </div>
                `;
            });
            html += '</div>';
            bookingListContent.innerHTML = html;
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function formatPrice(price) {
            if (!price) return '—';
            return new Intl.NumberFormat('vi-VN').format(price) + ' VND';
        }

        function getStatusColor(status) {
            const statusMap = {
                'New': 'info',
                'Confirmed': 'primary',
                'CheckedIn': 'success',
                'CheckedOut': 'secondary',
                'Cancelled': 'danger'
            };
            return statusMap[status] || 'secondary';
        }

        function closeBookingListModal() {
            bookingListOverlay.classList.remove('show');
            bookingListOverlay.setAttribute('aria-hidden', 'true');
        }

        bookingListClose?.addEventListener('click', closeBookingListModal);
        bookingListOverlay?.addEventListener('click', function (event) {
            if (event.target === bookingListOverlay) {
                closeBookingListModal();
            }
        });

        document.querySelectorAll('.booking-list-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const dataset = this.dataset;
                openBookingListModal({
                    roomId: dataset.roomId,
                    roomName: dataset.roomName,
                    date: dataset.date,
                    displayDate: dataset.displayDate
                });
            });
        });
    });
</script>

<style>
    * {
        box-sizing: border-box;
    }

    .booking-calendar-container {
        width: 100%;
        min-height: 100vh;
        padding: 24px;
        background: #f5f7fa;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        font-size: 14px;
    }

    .calendar-content {
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: #fff;
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.1);
    }

    .calendar-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: space-between;
        font-size: 13px;
    }

    .toolbar-dropdowns {
        display: grid;
        flex: 1;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 10px;
    }

    .toolbar-select {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .toolbar-select label {
        font-size: 11px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 600;
    }

    .toolbar-select .form-select {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        padding: 6px 14px;
        font-size: 13px;
    }

    .toolbar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .search-wrapper {
        position: relative;
    }

    .search-wrapper i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
    }

    .search-wrapper .form-control {
        border-radius: 999px;
        padding-left: 36px;
        min-width: 240px;
    }

    .refresh-btn {
        border-radius: 999px;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
    }

    .add-booking-btn {
        border-radius: 999px;
        padding: 8px 18px;
        font-weight: 600;
        border: none;
        font-size: 13px;
        background: linear-gradient(120deg, #35baf6, #716fff);
        box-shadow: 0 8px 18px rgba(113, 111, 255, 0.2);
    }

    .calendar-period-nav {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 12px;
        background: #fbfcff;
        display: flex;
        flex-direction: column;
        gap: 10px;
        font-size: 13px;
    }

    .year-scroll {
